 const WebViewElement = require('webViewElement').WebViewElement;
 const WebViewInternal = getInternalApi('webViewInternal');
 
+// Experiment: a rejected promise. The safe $Promise in this context
+// has no reject(), only the constructor ($Promise.self), race() and resolve().
+function rejectedPromise(error) {
+  return new $Promise.self((resolve, reject) => reject(error));
+}
+
+// Experiment: the guest's instance id, or 0 if there is none (not
+// created yet, destroyed, or the element was never attached).
+function currentGuestId(element) {
+  const internal = privates(element).internal;
+  return (internal && internal.guest && internal.guest.getId()) || 0;
+}
+
 // The Web naming conventions for enums are kebab-case while the WebView naming
 // conventions which are snake case. Convert from the kebab case convention to
 // the snake case convention.
@@ -149,4 +162,45 @@
         internal.viewInstanceId, names, callback);
+  }
+
+  // Returns a Promise<MediaStream> with one video track that shows the guest's
+  // contents. `options` may contain maxWidth, maxHeight, maxFrameRate (and
+  // minWidth/minHeight/minFrameRate), passed through as getUserMedia legacy
+  // "mandatory" constraints. Only the owning embedder frame can use the
+  // stream id; the track ends when the guest is destroyed.
+  captureStream(options) {
+    let guestId;
+    try {
+      guestId = currentGuestId(this);
+    } catch (e) {
+      return rejectedPromise(e);
+    }
+    if (!guestId) {
+      return rejectedPromise(new Error('The frame has no guest'));
+    }
+    const mandatory = {__proto__: null};
+    if (options) {
+      for (const key of ['maxWidth', 'maxHeight', 'maxFrameRate', 'minWidth',
+                         'minHeight', 'minFrameRate']) {
+        if (options[key] !== undefined) {
+          mandatory[key] = options[key];
+        }
+      }
+    }
+    return new $Promise.self((resolve, reject) => {
+      WebViewInternal.getCaptureStreamId(guestId, (streamId) => {
+        if (bindingUtil.hasLastError()) {
+          const error = bindingUtil.getLastErrorMessage();
+          bindingUtil.clearLastError();
+          reject(new Error(error));
+          return;
+        }
+        mandatory.chromeMediaSource = 'desktop';
+        mandatory.chromeMediaSourceId = streamId;
+        navigator.mediaDevices
+            .getUserMedia({audio: false, video: {mandatory}})
+            .then(resolve, reject);
+      });
+    });
   }
 
