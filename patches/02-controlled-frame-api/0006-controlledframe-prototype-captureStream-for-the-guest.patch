+// Registers a one-shot media stream id for the guest's contents, bound to the
+// calling (owner) frame's main frame and origin. The embedder turns the id into
+// a MediaStream with getUserMedia({video: {mandatory: {chromeMediaSource:
+// 'desktop', chromeMediaSourceId: id}}}).
+class WebViewInternalGetCaptureStreamIdFunction
+    : public WebViewInternalExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("webViewInternal.getCaptureStreamId",
+                             WEBVIEWINTERNAL_GETCAPTURESTREAMID)
+  WebViewInternalGetCaptureStreamIdFunction() = default;
+  WebViewInternalGetCaptureStreamIdFunction(
+      const WebViewInternalGetCaptureStreamIdFunction&) = delete;
+  WebViewInternalGetCaptureStreamIdFunction& operator=(
+      const WebViewInternalGetCaptureStreamIdFunction&) = delete;
+
+ protected:
+  ~WebViewInternalGetCaptureStreamIdFunction() override = default;
+
+ private:
+  // WebViewInternalExtensionFunction implementation.
+  ResponseAction Run() override;
+};
+
