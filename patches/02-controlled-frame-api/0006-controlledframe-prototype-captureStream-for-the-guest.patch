+
+// Uses the test guest view manager to wait for guest destruction.
+class ControlledFrameCaptureStreamTest : public ControlledFrameMoveBeforeTest {
+ public:
+  void SetUp() override {
+    // Browser tests draw nothing unless pixel output is enabled.
+    EnablePixelOutput();
+    ControlledFrameMoveBeforeTest::SetUp();
+  }
+};
+
+// captureStream() returns a live video track of the guest, the stream id it
+// uses can only be used once and only by the embedder that owns the guest,
+// and the track ends when the element (and so the guest) is removed.
+IN_PROC_BROWSER_TEST_F(ControlledFrameCaptureStreamTest, CaptureStream) {
+  web_app::IsolatedWebAppUrlInfo url_info =
+      CreateAndInstallEmptyApp(web_app::ManifestBuilder());
+  content::RenderFrameHost* app_frame = OpenApp(url_info.app_id());
+  ASSERT_TRUE(CreateControlledFrame(
+      app_frame, embedded_https_test_server().GetURL("/index.html")));
+  extensions::WebViewGuest* guest = GetWebViewGuest(app_frame);
+  ASSERT_TRUE(guest);
+
+  // Give the element a known size inside the (small) app viewport: only the
+  // part of the guest that is on screen is drawn, and so captured.
+  ASSERT_EQ(40, content::EvalJs(app_frame, R"(
+    (async () => {
+      const frame = document.querySelector('controlledframe');
+      frame.style.setProperty('position', 'fixed', 'important');
+      frame.style.setProperty('left', '0', 'important');
+      frame.style.setProperty('top', '0', 'important');
+      frame.style.setProperty('width', '320px', 'important');
+      frame.style.setProperty('height', '40px', 'important');
+      let h;
+      for (let i = 0; i < 100; i++) {
+        h = await frame.executeScript({code: 'innerHeight'});
+        if (h[0] === 40) {
+          return 40;
+        }
+        await new Promise(r => setTimeout(r, 50));
+      }
+      return JSON.stringify(h) + ' ' +
+          JSON.stringify(frame.getBoundingClientRect()) + ' ' +
+          frame.getAttribute('style') + ' ' + getComputedStyle(frame).height;
+    })();
+  )"));
+
+  // Paint the guest green. Alternate between two nearly identical greens on
+  // every animation frame so that the (damage-driven) capturer keeps
+  // delivering frames.
+  ASSERT_TRUE(content::ExecJs(guest->GetGuestMainFrame(), R"(
+    document.body.innerHTML = '';
+    let flip = false;
+    (function paint() {
+      flip = !flip;
+      document.documentElement.style.background =
+          flip ? 'rgb(0, 255, 0)' : 'rgb(0, 254, 0)';
+      requestAnimationFrame(paint);
+    })();
+  )"));
+
+  // The track delivers frames that show the guest's content.
+  EXPECT_EQ("green", content::EvalJs(app_frame, R"(
+    (async () => {
+      const frame = document.querySelector('controlledframe');
+      const stream = await frame.captureStream({maxWidth: 320,
+                                                maxHeight: 240});
+      if (stream.getVideoTracks().length !== 1) {
+        return 'wrong track count';
+      }
+      window.captureTrack = stream.getVideoTracks()[0];
+      const reader = new MediaStreamTrackProcessor(
+          {track: captureTrack.clone()}).readable.getReader();
+      let last = '';
+      for (let i = 0; i < 100; i++) {
+        const {value} = await reader.read();
+        const c = new OffscreenCanvas(value.displayWidth,
+                                      value.displayHeight);
+        const ctx = c.getContext('2d');
+        ctx.drawImage(value, 0, 0);
+        const d = ctx.getImageData(c.width >> 1, c.height >> 1, 1, 1).data;
+        const buf = new Uint8Array(value.allocationSize());
+        const layout = await value.copyTo(buf);
+        const yc = buf[layout[0].offset +
+                       (value.codedHeight >> 1) * layout[0].stride +
+                       (value.codedWidth >> 1)];
+        last = `${d[0]},${d[1]},${d[2]} ${value.format} ` +
+               `${value.displayWidth}x${value.displayHeight} Y=${yc}`;
+        value.close();
+        if (d[0] < 60 && d[1] > 180 && d[2] < 60) {
+          reader.cancel();
+          return 'green';
+        }
+      }
+      return 'no green frame, last pixel ' + last + ' app viewport ' +
+          innerWidth + 'x' + innerHeight + ' element ' +
+          JSON.stringify(frame.getBoundingClientRect());
+    })();
+  )"));
+
+  // Obtain a second stream id without consuming it: the element passes the
+  // id to navigator.mediaDevices.getUserMedia() in the page's world.
+  const std::string stream_id = content::EvalJs(app_frame, R"(
+    (async () => {
+      const realGetUserMedia = navigator.mediaDevices.getUserMedia;
+      let id = '';
+      navigator.mediaDevices.getUserMedia = (constraints) => {
+        id = constraints.video.mandatory.chromeMediaSourceId;
+        return Promise.reject(new Error('intercepted'));
+      };
+      await document.querySelector('controlledframe').captureStream()
+          .catch(() => {});
+      navigator.mediaDevices.getUserMedia = realGetUserMedia;
+      return id;
+    })();
+  )")
+                                    .ExtractString();
+  ASSERT_FALSE(stream_id.empty());
+  const std::string use_id_script = content::JsReplace(R"(
+    navigator.mediaDevices.getUserMedia({video: {mandatory: {
+        chromeMediaSource: 'desktop', chromeMediaSourceId: $1}}})
+      .then(s => { s.getTracks().forEach(t => t.stop()); return 'success'; },
+            e => 'error')
+  )",
+                                                       stream_id);
+
+  // Another window of the same app (same origin, different frame) cannot
+  // use the id.
+  content::RenderFrameHost* other_app_frame = OpenApp(url_info.app_id());
+  ASSERT_NE(other_app_frame, app_frame);
+  EXPECT_EQ("error", content::EvalJs(other_app_frame, use_id_script));
+
+  // A page of another origin cannot use the id.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_https_test_server().GetURL("/index.html")));
+  EXPECT_EQ("error", content::EvalJs(browser()
+                                         ->tab_strip_model()
+                                         ->GetActiveWebContents()
+                                         ->GetPrimaryMainFrame(),
+                                     use_id_script));
+
+  // The guest itself cannot use the id.
+  EXPECT_EQ("error",
+            content::EvalJs(guest->GetGuestMainFrame(), use_id_script));
+
+  // The owner can (the id was valid all along), but only once.
+  EXPECT_EQ("success", content::EvalJs(app_frame, use_id_script));
+  EXPECT_EQ("error", content::EvalJs(app_frame, use_id_script));
+
+  // The browser refuses to issue an id for the guest to a frame that does not
+  // own it, even if that frame names the guest's instance id. A same-process
+  // frame (an about:blank iframe of the app) gets an error from the owner
+  // check.
+  auto get_id_from = [&](content::RenderFrameHost* rfh) {
+    auto function = base::MakeRefCounted<
+        extensions::WebViewInternalGetCaptureStreamIdFunction>();
+    function->SetName("webViewInternal.getCaptureStreamId");
+    function->SetRenderFrameHost(rfh);
+    function->set_source_process_id(rfh->GetProcess()->GetDeprecatedID());
+    return extensions::api_test_utils::RunFunctionAndReturnError(
+        function.get(), content::JsReplace("[$1]", guest->guest_instance_id()),
+        profile());
+  };
+  ASSERT_TRUE(content::ExecJs(app_frame, R"(
+    new Promise(resolve => {
+      const f = document.createElement('iframe');
+      f.name = 'not-the-owner';
+      f.onload = resolve;
+      document.body.appendChild(f);
+    });
+  )"));
+  content::RenderFrameHost* app_iframe = content::FrameMatchingPredicate(
+      app_frame->GetPage(),
+      base::BindRepeating(&content::FrameMatchesName, "not-the-owner"));
+  ASSERT_TRUE(app_iframe);
+  ASSERT_EQ(app_iframe->GetProcess(), app_frame->GetProcess());
+  EXPECT_EQ("Only the embedder of the guest can capture it",
+            get_id_from(app_iframe));
+  // The owner gets an id the same way.
+  {
+    auto function = base::MakeRefCounted<
+        extensions::WebViewInternalGetCaptureStreamIdFunction>();
+    function->SetName("webViewInternal.getCaptureStreamId");
+    function->SetRenderFrameHost(app_frame);
+    function->set_source_process_id(app_frame->GetProcess()->GetDeprecatedID());
+    std::optional<base::Value> result =
+        extensions::api_test_utils::RunFunctionAndReturnSingleResult(
+            function.get(),
+            content::JsReplace("[$1]", guest->guest_instance_id()), profile());
+    ASSERT_TRUE(result && result->is_string());
+    EXPECT_FALSE(result->GetString().empty());
+  }
+  // A frame in another process that names the guest is treated as a bad
+  // renderer by the guest view manager (existing behaviour) and is killed.
+  if (other_app_frame->GetProcess() != app_frame->GetProcess()) {
+    content::ScopedAllowRendererCrashes allow_crashes(other_app_frame);
+    content::RenderProcessHostWatcher watcher(
+        other_app_frame->GetProcess(),
+        content::RenderProcessHostWatcher::WATCH_FOR_PROCESS_EXIT);
+    EXPECT_EQ("Could not find guest", get_id_from(other_app_frame));
+    watcher.Wait();
+  }
+
+  // Removing the element destroys the guest and ends the track.
+  ASSERT_TRUE(content::ExecJs(
+      app_frame, "document.querySelector('controlledframe').remove();"));
+  guest_view_manager()->WaitForAllGuestsDeleted();
+  EXPECT_EQ("ended", content::EvalJs(app_frame, R"(
+    (async () => {
+      for (let i = 0; i < 100 && captureTrack.readyState !== 'ended'; i++) {
+        await new Promise(r => setTimeout(r, 50));
+      }
+      return captureTrack.readyState;
+    })();
+  )"));
 }
 
