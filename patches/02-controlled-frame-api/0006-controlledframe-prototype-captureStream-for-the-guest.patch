+
+ExtensionFunction::ResponseAction
+WebViewInternalGetCaptureStreamIdFunction::Run() {
+  WebViewGuest& guest = GetGuest();
+  content::RenderFrameHost* caller = render_frame_host();
+  // Only the frame that owns the guest may capture it.
+  if (!caller || !guest.attached() || guest.owner_rfh() != caller) {
+    return RespondNow(Error("Only the embedder of the guest can capture it"));
+  }
+  content::RenderFrameHost* guest_main_frame = guest.GetGuestMainFrame();
+  content::WebContents* embedder_contents =
+      content::WebContents::FromRenderFrameHost(caller);
+  content::WebContents* guest_contents =
+      content::WebContents::FromRenderFrameHost(guest_main_frame);
+  // With GuestViewMPArch the guest page lives in the embedder's WebContents,
+  // so a WebContents capture would capture the whole embedder. Not supported.
+  if (!guest_main_frame || !guest_contents ||
+      guest_contents == embedder_contents) {
+    return RespondNow(Error("Capture is not supported for this guest"));
+  }
+
+  content::DesktopMediaID source(
+      content::DesktopMediaID::TYPE_WEB_CONTENTS,
+      content::DesktopMediaID::kNullId,
+      content::WebContentsMediaCaptureId(
+          guest_main_frame->GetProcess()->GetDeprecatedID(),
+          guest_main_frame->GetRoutingID()));
+
+  // DesktopCaptureAccessHandler validates the id against the primary main
+  // frame of the requesting WebContents and the requesting frame's origin.
+  content::RenderFrameHost* embedder_main_frame =
+      embedder_contents->GetPrimaryMainFrame();
+  std::string id =
+      content::DesktopStreamsRegistry::GetInstance()->RegisterStream(
+          embedder_main_frame->GetProcess()->GetDeprecatedID(),
+          embedder_main_frame->GetRoutingID(), caller->GetLastCommittedOrigin(),
+          source, content::kRegistryStreamTypeDesktop);
+  return RespondNow(WithArguments(id));
 }
 
