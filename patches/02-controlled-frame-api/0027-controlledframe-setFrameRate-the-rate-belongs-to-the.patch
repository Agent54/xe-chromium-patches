+namespace {
+
+// The embedder's interval for one guest, kept with the guest's WebContents and
+// applied to whichever frame sink its main frame currently has. Combined with
+// GuestFrameTextureSource requests in the registry (the lowest rate wins).
+class GuestFrameInterval : public WebContentsUserData<GuestFrameInterval>,
+                           public WebContentsObserver {
+ public:
+  ~GuestFrameInterval() override { ApplyTo(viz::FrameSinkId()); }
+
+  void Set(base::TimeDelta interval) {
+    interval_ = interval;
+    Apply();
+  }
+
+  // WebContentsObserver:
+  void RenderFrameHostChanged(RenderFrameHost* old_host,
+                              RenderFrameHost* new_host) override {
+    if (new_host && new_host->IsInPrimaryMainFrame()) {
+      Apply();
+    }
+  }
+  void PrimaryPageChanged(Page& page) override { Apply(); }
+  void WebContentsDestroyed() override { ApplyTo(viz::FrameSinkId()); }
+
+ private:
+  friend class WebContentsUserData<GuestFrameInterval>;
+  explicit GuestFrameInterval(WebContents* contents)
+      : WebContentsUserData(*contents), WebContentsObserver(contents) {}
+
+  void Apply() {
+    RenderWidgetHost* rwh =
+        web_contents() ? web_contents()->GetPrimaryMainFrame()
+                             ->GetRenderWidgetHost()
+                       : nullptr;
+    ApplyTo(rwh ? static_cast<RenderWidgetHostImpl*>(rwh)->GetFrameSinkId()
+                : viz::FrameSinkId());
+  }
+
+  void ApplyTo(const viz::FrameSinkId& sink) {
+    if (applied_sink_.is_valid() && applied_sink_ != sink) {
+      SetFrameSinkIntervalForRequester(applied_sink_, this, base::TimeDelta());
+      applied_sink_ = viz::FrameSinkId();
+    }
+    if (!sink.is_valid() || !GetHostFrameSinkManager()) {
+      return;
+    }
+    if (interval_.is_positive() || applied_sink_.is_valid()) {
+      SetFrameSinkIntervalForRequester(sink, this, interval_);
+      applied_sink_ = interval_.is_positive() ? sink : viz::FrameSinkId();
+    }
+  }
+
+  base::TimeDelta interval_;
+  viz::FrameSinkId applied_sink_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(GuestFrameInterval);
+
+}  // namespace
+
+CONTENT_EXPORT void SetGuestFrameInterval(WebContents* guest,
+                                          base::TimeDelta interval) {
   CHECK_CURRENTLY_ON(content::BrowserThread::UI);
-  if (!rwh || !GetHostFrameSinkManager()) {
+  if (!guest) {
     return;
   }
-  // The embedder's request; combined with GuestFrameTextureSource requests
-  // (the lowest rate wins).
-  static const char kEmbedderRequester = 0;
-  SetFrameSinkIntervalForRequester(
-      static_cast<RenderWidgetHostImpl*>(rwh)->GetFrameSinkId(),
-      &kEmbedderRequester, interval);
+  GuestFrameInterval::CreateForWebContents(guest);
+  GuestFrameInterval::FromWebContents(guest)->Set(interval);
 }
 
 }  // namespace content
