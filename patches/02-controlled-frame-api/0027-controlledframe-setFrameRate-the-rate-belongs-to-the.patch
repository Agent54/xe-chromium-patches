+// setFrameRate() belongs to the guest element: it still holds after the
+// guest navigates to another site (another process, another frame sink), and
+// setFrameRate(0) clears it.
+IN_PROC_BROWSER_TEST_F(ControlledFrameTextureSourceTest,
+                       SetFrameRateFollowsNavigation) {
+  web_app::IsolatedWebAppUrlInfo url_info =
+      CreateAndInstallEmptyApp(web_app::ManifestBuilder());
+  content::RenderFrameHost* app_frame = OpenApp(url_info.app_id());
+  extensions::WebViewGuest* guest = CreateSizedFrame(
+      app_frame, embedded_https_test_server().GetURL("/index.html"));
+  ASSERT_TRUE(guest);
+  // requestAnimationFrame callbacks per second in the guest, over 1.5 s.
+  constexpr char kRafRate[] = R"(
+    new Promise(resolve => {
+      let n = 0, t0 = 0;
+      (function f(t) {
+        if (!t0) t0 = t;
+        else n++;
+        if (t - t0 < 1500) requestAnimationFrame(f);
+        else resolve(n / ((t - t0) / 1000));
+      })(0);
+    });)";
+  auto set_rate = [&](int fps) {
+    return content::ExecJs(
+        app_frame,
+        content::JsReplace(
+            "document.querySelector('controlledframe').setFrameRate($1)", fps));
+  };
+  const double full = content::EvalJs(guest->GetGuestMainFrame(), kRafRate)
+                          .ExtractDouble();
+  ASSERT_GT(full, 25);
+  ASSERT_TRUE(set_rate(10));
+  EXPECT_LT(content::EvalJs(guest->GetGuestMainFrame(), kRafRate)
+                .ExtractDouble(),
+            14);
+
+  const GURL cross_site =
+      embedded_https_test_server().GetURL("cross.test", "/index.html");
+  content::RenderProcessHost* old_process =
+      guest->GetGuestMainFrame()->GetProcess();
+  ASSERT_TRUE(content::ExecJs(app_frame, content::JsReplace(R"(
+    new Promise(r => {
+      const f = document.querySelector('controlledframe');
+      f.addEventListener('loadstop', r, {once: true});
+      f.src = $1;
+    });)",
+                                                            cross_site)));
+  content::RenderFrameHost* new_main =
+      GetWebViewGuest(app_frame)->GetGuestMainFrame();
+  ASSERT_EQ(cross_site, new_main->GetLastCommittedURL());
+  EXPECT_NE(old_process, new_main->GetProcess());
+  EXPECT_LT(content::EvalJs(new_main, kRafRate).ExtractDouble(), 14);
+
+  ASSERT_TRUE(set_rate(0));
+  EXPECT_GT(content::EvalJs(new_main, kRafRate).ExtractDouble(), 25);
+}
+
+// The methods these patches add never throw: with no guest (not attached,
+// not created yet, destroyed) each returns a rejected promise.
+IN_PROC_BROWSER_TEST_F(ControlledFrameTextureSourceTest, NoGuestRejects) {
+  web_app::IsolatedWebAppUrlInfo url_info =
+      CreateAndInstallEmptyApp(web_app::ManifestBuilder());
+  content::RenderFrameHost* app_frame = OpenApp(url_info.app_id());
+  ASSERT_TRUE(CreateSizedFrame(
+      app_frame, embedded_https_test_server().GetURL("/index.html")));
+  ASSERT_TRUE(content::ExecJs(app_frame, R"(
+    window.callAll = async (f) => {
+      const out = [];
+      for (const [name, call] of [
+               ['setFrameRate', () => f.setFrameRate(10)],
+               ['captureStream', () => f.captureStream()],
+               ['createTextureSource',
+                () => f.createTextureSource({width: 32, height: 32})]]) {
+        let p;
+        try {
+          p = call();
+        } catch (e) {
+          out.push(name + ' threw ' + e);
+          continue;
+        }
+        if (!p || typeof p.then !== 'function') {
+          out.push(name + ' returned no promise');
+          continue;
+        }
+        try {
+          await p;
+          out.push(name + ' resolved');
+        } catch (e) {
+          out.push(name + ' rejected');
+        }
+      }
+      return out.join(', ');
+    };
+    window.stale = document.querySelector('controlledframe');
+    stale.remove();)"));
+  guest_view_manager()->WaitForAllGuestsDeleted();
+  constexpr char kAllRejected[] =
+      "setFrameRate rejected, captureStream rejected, "
+      "createTextureSource rejected";
+  // Destroyed guest (element removed).
+  EXPECT_EQ(kAllRejected, content::EvalJs(app_frame, "callAll(stale)"));
+  // Never attached.
+  EXPECT_EQ(kAllRejected,
+            content::EvalJs(
+                app_frame,
+                "callAll(document.createElement('controlledframe'))"));
+  // Attached, guest not created yet (no src).
+  EXPECT_EQ(kAllRejected, content::EvalJs(app_frame, R"(
+    (() => {
+      const f = document.createElement('controlledframe');
+      document.body.appendChild(f);
+      return callAll(f);
+    })())"));
+}
