+}
+
+// static
+bool GuestFrameTextureHost::CanAccessGuestForTesting(
+    RenderFrameHost* caller,
+    RenderFrameHost* guest_main_frame) {
+  FrameTreeNode* inner_root =
+      static_cast<RenderFrameHostImpl*>(guest_main_frame)->frame_tree_node();
+  RenderFrameProxyHost* proxy =
+      inner_root->render_manager()->GetProxyToOuterDelegate();
+  if (!proxy || proxy->GetProcess() != caller->GetProcess()) {
+    return false;
+  }
+  return FindOwnedGuestViewForFrame(caller, proxy->GetFrameToken()) != nullptr;
+}
+
+// static
+RenderWidgetHostViewChildFrame*
+GuestFrameTextureHost::FindOwnedGuestViewForFrame(
+    RenderFrameHost* caller,
+    const blink::RemoteFrameToken& guest_frame,
+    WebContentsImpl** guest_contents_out) {
+  auto* rfh = static_cast<RenderFrameHostImpl*>(caller);
   RenderFrameProxyHost* proxy = RenderFrameProxyHost::FromFrameToken(
       rfh->GetProcess()->GetDeprecatedID(), guest_frame);
   if (!proxy) {
diff --git a/content/browser/renderer_host/guest_frame_texture_host.h b/content/browser/renderer_host/guest_frame_texture_host.h
--- a/content/browser/renderer_host/guest_frame_texture_host.h
+++ b/content/browser/renderer_host/guest_frame_texture_host.h
@@ -52,6 +52,19 @@
       const blink::RemoteFrameToken& guest_frame,
       WebContentsImpl** guest_contents_out = nullptr);
 
+  // The ownership check used for every request, for a given calling frame.
+  static RenderWidgetHostViewChildFrame* FindOwnedGuestViewForFrame(
+      RenderFrameHost* caller,
+      const blink::RemoteFrameToken& guest_frame,
+      WebContentsImpl** guest_contents_out = nullptr);
+
+  // Test-only: whether `caller` passes the ownership check for the guest
+  // whose main frame is `guest_main_frame`, using the token of the guest's
+  // proxy in the caller's process (false if the caller's process has none,
+  // i.e. the caller could not even name the guest).
+  static bool CanAccessGuestForTesting(RenderFrameHost* caller,
+                                       RenderFrameHost* guest_main_frame);
+
  private:
   ~GuestFrameTextureHost() final;
 
