 void GuestFrameTextureSource::close() {
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
   ended_ = true;
-  source_.reset();
   if (pending_read_) {
     pending_read_->Resolve(nullptr);
     pending_read_ = nullptr;
+  }
+  host_.reset();
+  ReleaseResources();
