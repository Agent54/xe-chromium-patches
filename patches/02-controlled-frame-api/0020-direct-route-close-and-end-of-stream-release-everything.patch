+
+void GuestFrameTextureSource::ReleaseResources() {
+  Vector<bool> held;
+  Vector<gpu::SyncToken> tokens;
+  for (Slot& slot : slots_) {
+    const bool is_held = slot.state == SlotState::kHeld;
+    // A ready frame nobody read only has to follow its copy; a free slot its
+    // last reader; a slot with a copy pending is released by the browser
+    // after that copy.
+    const gpu::SyncToken token = slot.state == SlotState::kReady
+                                     ? slot.ready_token
+                                     : slot.release_token;
+    held.push_back(is_held);
+    tokens.push_back(is_held ? gpu::SyncToken() : token);
+    if (!is_held) {
+      slot.state = SlotState::kReleased;
+      if (slot.shared_image) {
+        slot.shared_image->UpdateDestructionSyncToken(token);
+        slot.shared_image = nullptr;
+      }
+    }
+  }
+  if (!source_.is_bound()) {
+    return;
+  }
+  source_->Stop(std::move(held), std::move(tokens));
+  if (!CountIn(SlotState::kHeld)) {
+    source_.reset();
   }
 }
 
