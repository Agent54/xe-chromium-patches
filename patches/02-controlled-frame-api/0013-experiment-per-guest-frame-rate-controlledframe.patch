From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <noreply@xe.invalid>
Date: Sun, 22 Nov 2026 15:39:21 +0000
Subject: [PATCH 13/50] experiment: per-guest frame rate (controlledframe.setFrameRate)

- viz.mojom.FrameSinkManager.SetFrameSinkThrottleInterval(sink, interval):
  per-sink BeginFrame interval for a frame sink and its descendants, kept in
  FrameSinkManagerImpl and applied after the existing throttling rules
  (wins over Throttle()/global throttling and over capture); zero clears.
- content::SetRenderWidgetHostFrameInterval(rwh, interval).
- webViewInternal.setFrameRate(instanceId, fps) (owner frame only) and
  HTMLControlledFrameElement.setFrameRate(fps); 0 restores the normal rate.
---
diff --git a/chrome/renderer/resources/controlled_frame/html_controlled_frame_element.js b/chrome/renderer/resources/controlled_frame/html_controlled_frame_element.js
--- a/chrome/renderer/resources/controlled_frame/html_controlled_frame_element.js
+++ b/chrome/renderer/resources/controlled_frame/html_controlled_frame_element.js
@@ -162,6 +162,31 @@
         internal.viewInstanceId, names, callback);
   }
 
+  // Experiment: limits the guest's frame (BeginFrame/rAF) rate;
+  // 0 restores the normal rate. Returns a Promise.
+  setFrameRate(framesPerSecond) {
+    let guestId;
+    try {
+      guestId = currentGuestId(this);
+    } catch (e) {
+      return rejectedPromise(e);
+    }
+    if (!guestId) {
+      return rejectedPromise(new Error('The frame has no guest'));
+    }
+    return new $Promise.self((resolve, reject) => {
+      WebViewInternal.setFrameRate(guestId, framesPerSecond, () => {
+        if (bindingUtil.hasLastError()) {
+          const error = bindingUtil.getLastErrorMessage();
+          bindingUtil.clearLastError();
+          reject(new Error(error));
+          return;
+        }
+        resolve();
+      });
+    });
+  }
+
