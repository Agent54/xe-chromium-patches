+ExtensionFunction::ResponseAction WebViewInternalSetFrameRateFunction::Run() {
+  std::optional<web_view_internal::SetFrameRate::Params> params =
+      web_view_internal::SetFrameRate::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  WebViewGuest& guest = GetGuest();
+  content::RenderFrameHost* caller = render_frame_host();
+  if (!caller || !guest.attached() || guest.owner_rfh() != caller) {
+    return RespondNow(Error("Only the embedder of the guest can set its rate"));
+  }
+  content::RenderFrameHost* guest_main_frame = guest.GetGuestMainFrame();
+  if (!guest_main_frame || !guest_main_frame->GetRenderWidgetHost()) {
+    return RespondNow(Error("The guest has no widget"));
+  }
+  const double fps = params->frames_per_second;
+  content::SetRenderWidgetHostFrameInterval(
+      guest_main_frame->GetRenderWidgetHost(),
+      fps > 0 ? base::Seconds(1.0 / fps) : base::TimeDelta());
+  return RespondNow(NoArguments());
 }
 
