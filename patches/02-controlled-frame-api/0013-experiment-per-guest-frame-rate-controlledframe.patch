+void FrameSinkManagerImpl::SetFrameSinkThrottleInterval(
+    const FrameSinkId& frame_sink_id,
+    base::TimeDelta interval) {
+  if (interval.is_positive()) {
+    explicit_throttle_intervals_[frame_sink_id] = interval;
+  } else {
+    explicit_throttle_intervals_.erase(frame_sink_id);
+  }
+  UpdateThrottling();
+}
+
 void FrameSinkManagerImpl::StopThrottlingAllFrameSinks() {
   global_throttle_interval_ = std::nullopt;
   UpdateThrottling();
@@ -1380,6 +1391,16 @@
   }
 
   ApplyThrottlingRules(frame_sink_ids_to_throttle_, captured_frame_sink_ids_);
+
+  // Experiment: explicit per-sink intervals win, also over capture.
+  for (const auto& [root, interval] : explicit_throttle_intervals_) {
+    RecurseChildren(root, [this, interval](const FrameSinkId& frame_sink_id) {
+      if (auto* support = GetFrameSinkForId(frame_sink_id)) {
+        support->SetAllowThrottling(true);
+        support->SetThrottleInterval(interval);
+      }
+    });
+  }
 }
 
