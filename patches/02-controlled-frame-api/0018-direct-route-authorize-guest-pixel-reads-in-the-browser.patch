+
+  // Screenshots disabled by policy (the rule captureVisibleRegion() follows):
+  // a running source ends at its next copy and a new one gets no frame.
+  ASSERT_EQ("green", content::EvalJs(app_frame, R"(
+    (async () => {
+      window.running = await document.querySelector('controlledframe')
+          .createTextureSource({width: 320, height: 40});
+      return readColor(running, 'green');
+    })();)"));
+  PrefService* prefs =
+      Profile::FromBrowserContext(app_frame->GetBrowserContext())->GetPrefs();
+  prefs->SetBoolean(policy::policy_prefs::kDisableScreenshots, true);
+  EXPECT_EQ("ended", content::EvalJs(app_frame, R"(
+    (async () => {
+      for (let i = 0; i < 100; i++) {
+        const vf = await running.read();
+        if (!vf) return 'ended';
+        vf.close();
+      }
+      return 'still reading';
+    })();)"));
+  EXPECT_EQ("no frame", content::EvalJs(app_frame, R"(
+    (async () => {
+      const src = await document.querySelector('controlledframe')
+          .createTextureSource({width: 320, height: 40});
+      const vf = await src.read();
+      if (vf) { vf.close(); return 'got a frame'; }
+      return 'no frame';
+    })();)"));
+  prefs->SetBoolean(policy::policy_prefs::kDisableScreenshots, false);
 
