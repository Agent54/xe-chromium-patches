From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <luke@agent54.org>
Date: Sun, 22 Nov 2026 18:38:26 +0000
Subject: [PATCH 18/50] direct route: authorize guest pixel reads in the browser (Controlled Frame, screenshot policy)

GuestFrameTextureHost's ownership check (the caller's process, exact parent
frame, outer delegate, inner WebContents for a guest) now also asks the
embedder through a new ContentBrowserClient::MayReadGuestFramePixels()
(default false). Chrome allows it only for a guest owned by a Controlled
Frame embedder, read by that owner frame, with the controlled-frame
permissions policy feature enabled, and when screenshots are not restricted
(the IsScreenshotRestricted() rule that captureVisibleRegion() follows). The
check runs for every copy, so a policy change stops the next copy.

Viz's redaction of secure-output-only textures in copy passes
(SurfaceAggregator, in_copy_request_pass) applies to these copies unchanged;
the copy is an ordinary CopyOutputRequest on the guest's surface.

Test: ControlledFrameTextureSourceTest.Ownership also checks that with
screenshots disabled by policy a running source ends and a new one gets no
frame.
---
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -688,6 +688,7 @@
 #include "extensions/browser/extension_config_map.h"
 #include "extensions/browser/extension_config_map_factory.h"
 #include "extensions/browser/extension_mojo_binder_registry.h"
+#include "extensions/browser/extensions_browser_client.h"
 #include "extensions/browser/extension_mojo_binder_registry_factory.h"
 #include "extensions/browser/extension_protocols.h"
 #include "extensions/browser/extension_registry.h"
@@ -10112,4 +10113,29 @@
   return false;
+}
+
+bool ChromeContentBrowserClient::MayReadGuestFramePixels(
+    content::RenderFrameHost* embedder,
+    content::WebContents* guest_contents) {
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+  // Only a <controlledframe> guest, read by the frame that owns it, in a
+  // context that has the Controlled Frame capability, and not when
+  // screenshots are restricted (the same policy as captureVisibleRegion()).
+  guest_view::GuestViewBase* guest =
+      guest_view::GuestViewBase::FromWebContents(guest_contents);
+  if (!guest || !guest->IsOwnedByControlledFrameEmbedder() ||
+      guest->owner_rfh() != embedder) {
+    return false;
+  }
+  if (!embedder->IsFeatureEnabled(
+          network::mojom::PermissionsPolicyFeature::kControlledFrame)) {
+    return false;
+  }
+  return extensions::ExtensionsBrowserClient::Get()
+      ->IsScreenshotRestricted(guest_contents)
+      .has_value();
+#else
+  return false;
+#endif
 }
 
