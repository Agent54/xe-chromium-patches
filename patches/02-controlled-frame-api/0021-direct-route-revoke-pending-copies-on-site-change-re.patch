-      : host_(std::move(host)),
+      : WebContentsObserver(guest_contents),
+        host_(std::move(host)),
         guest_frame_(guest_frame),
         size_(size),
         context_provider_(std::move(context_provider)),
@@ -190,7 +196,9 @@
                           : base::TimeDelta()),
         account_(std::move(account)),
         in_flight_(images_.size(), false),
-        release_after_copy_(images_.size()) {
+        release_after_copy_(images_.size()),
+        site_(net::SchemefulSite(guest_contents->GetPrimaryMainFrame()
+                                     ->GetLastCommittedOrigin())) {
     SetGuestInterval(base::TimeDelta());
     if (backpressure_ || cap_interval_.is_positive()) {
       // Also re-applies the cap if the guest's frame sink changes.
@@ -233,6 +241,21 @@
     in_flight_[index] = true;
     ++requests_in_period_;
     Issue(index, release_sync_token, std::move(callback), /*retries=*/2);
+  }
+
+  // WebContentsObserver: the guest's main page changed. If it is another
+  // site, copies requested for the previous page are cancelled before they
+  // are drawn and requested again (with a new ownership check) for the new
+  // one.
+  void PrimaryPageChanged(Page& page) override {
+    net::SchemefulSite site(
+        page.GetMainDocument().GetLastCommittedOrigin());
+    if (site == site_) {
+      return;
+    }
+    site_ = std::move(site);
+    ++generation_;
+    CancelPendingCopies();
   }
 
   void Stop(const std::vector<bool>& held,
@@ -308,7 +331,8 @@
         viz::CopyOutputRequest::ResultDestination::kSharedImage,
         base::BindOnce(&GuestFrameTextureSourceHostImpl::OnCopied,
                        weak_factory_.GetWeakPtr(), index, release_sync_token,
-                       std::move(callback), retries));
+                       std::move(callback), retries, generation_,
+                       view->GetFrameSinkId()));
     request->set_result_task_runner(
         base::SingleThreadTaskRunner::GetCurrentDefault());
     request->set_area(gfx::Rect(source_size));
@@ -351,12 +375,35 @@
                 gpu::SyncToken release_sync_token,
                 CopyNextFrameCallback callback,
                 int retries,
+                uint64_t generation,
+                viz::FrameSinkId sink,
                 std::unique_ptr<viz::CopyOutputResult> result) {
     if (result->IsEmpty()) {
+      if (!stopped_ && generation != generation_) {
+        // Cancelled because the guest changed site: request again.
+        Issue(index, release_sync_token, std::move(callback), retries);
+        return;
+      }
       // The guest's frame sink went away (e.g. cross-process navigation of
-      // the guest): retry on the current one, if the guest still exists.
+      // the guest), or the embedding changed: retry on the current one, if
+      // the guest still exists and is still owned.
       if (retries > 0 && !stopped_) {
         Issue(index, release_sync_token, std::move(callback), retries - 1);
+        return;
+      }
+      Reply(index, std::move(callback), false, gpu::SyncToken());
+      return;
+    }
+    // The copy was requested while the guest was owned; it is handed out only
+    // if it still is, on the same frame sink, and the guest has not changed
+    // site since. (Viz itself drops a request whose guest was re-embedded
+    // elsewhere: a different embed token, see
+    // CompositorFrameSinkSupport::TakeCopyOutputRequests.)
+    RenderWidgetHostViewChildFrame* view =
+        host_ ? host_->FindOwnedGuestView(guest_frame_) : nullptr;
+    if (!view || view->GetFrameSinkId() != sink || generation != generation_) {
+      if (view && !stopped_) {
+        Issue(index, release_sync_token, std::move(callback), retries);
         return;
       }
       Reply(index, std::move(callback), false, gpu::SyncToken());
@@ -430,6 +477,9 @@
   // Frame sinks this source has sent copy requests to.
   base::flat_set<viz::FrameSinkId> requested_sinks_;
   bool stopped_ = false;
+  // Site of the guest's main page; a change cancels pending copies.
+  net::SchemefulSite site_;
+  uint64_t generation_ = 0;
   base::WeakPtrFactory<GuestFrameTextureSourceHostImpl> weak_factory_{this};
 };
 
