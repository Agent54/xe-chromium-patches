+// One source: a ring of browser-allocated shared images for one guest of one
+// document. Lives while the renderer keeps its remote (or the document).
+class GuestFrameTextureSourceHostImpl
+    : public blink::mojom::GuestFrameTextureSourceHost {
+ public:
+  GuestFrameTextureSourceHostImpl(
+      base::WeakPtr<GuestFrameTextureHost> host,
+      const blink::RemoteFrameToken& guest_frame,
+      gfx::Size size,
+      scoped_refptr<viz::RasterContextProvider> context_provider,
+      std::vector<scoped_refptr<gpu::ClientSharedImage>> images,
+      base::ScopedClosureRunner capture_handle)
+      : host_(std::move(host)),
+        guest_frame_(guest_frame),
+        size_(size),
+        context_provider_(std::move(context_provider)),
+        images_(std::move(images)),
+        capture_handle_(std::move(capture_handle)) {}
+
+  ~GuestFrameTextureSourceHostImpl() override {
+    // The renderer holds its own imported references; ours go away here.
+    gpu::SyncToken token = context_provider_->SharedImageInterface()
+                               ->GenUnverifiedSyncToken();
+    for (auto& image : images_) {
+      image->UpdateDestructionSyncToken(token);
+    }
+  }
+
+  // blink::mojom::GuestFrameTextureSourceHost:
+  void CopyNextFrame(uint32_t index,
+                     const gpu::SyncToken& release_sync_token,
+                     CopyNextFrameCallback callback) override {
+    if (index >= images_.size()) {
+      std::move(callback).Run(false, gpu::SyncToken());
+      return;
+    }
+    Issue(index, release_sync_token, std::move(callback), /*retries=*/2);
+  }
+
+ private:
+  void Issue(uint32_t index,
+             const gpu::SyncToken& release_sync_token,
+             CopyNextFrameCallback callback,
+             int retries) {
+    // Ownership is re-checked for every copy (the guest may have been
+    // detached, moved or destroyed since the source was created).
+    RenderWidgetHostViewChildFrame* view =
+        host_ ? host_->FindOwnedGuestView(guest_frame_) : nullptr;
+    const gfx::Size source_size =
+        view ? view->GetCompositorViewportPixelSize() : gfx::Size();
+    if (!view || !view->IsSurfaceAvailableForCopy() || source_size.IsEmpty()) {
+      std::move(callback).Run(false, gpu::SyncToken());
+      return;
+    }
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSharedImage,
+        base::BindOnce(&GuestFrameTextureSourceHostImpl::OnCopied,
+                       weak_factory_.GetWeakPtr(), index, release_sync_token,
+                       std::move(callback), retries));
+    request->set_result_task_runner(
+        base::SingleThreadTaskRunner::GetCurrentDefault());
+    request->set_area(gfx::Rect(source_size));
+    request->set_result_selection(gfx::Rect(size_));
+    request->SetScaleRatio(
+        gfx::Vector2d(source_size.width(), source_size.height()),
+        gfx::Vector2d(size_.width(), size_.height()));
+    request->set_blit_request(viz::BlitRequest(
+        gfx::Point(), viz::LetterboxingBehavior::kDoNotLetterbox,
+        images_[index], release_sync_token,
+        /*populates_mappable_shared_image=*/false));
+    request->set_wait_for_new_frame_key(wait_key_);
+    GetHostFrameSinkManager()->RequestCopyOfOutput(
+        view->GetCurrentSurfaceId(), std::move(request),
+        /*capture_exact_surface_id=*/false, base::TimeDelta());
+  }
+
+  void OnCopied(uint32_t index,
+                gpu::SyncToken release_sync_token,
+                CopyNextFrameCallback callback,
+                int retries,
+                std::unique_ptr<viz::CopyOutputResult> result) {
+    if (result->IsEmpty()) {
+      // The guest's frame sink went away (e.g. cross-process navigation of
+      // the guest): retry on the current one, if the guest still exists.
+      if (retries > 0) {
+        Issue(index, release_sync_token, std::move(callback), retries - 1);
+        return;
+      }
+      std::move(callback).Run(false, gpu::SyncToken());
+      return;
+    }
+    std::move(callback).Run(true, result->sync_token());
+  }
+
+  base::WeakPtr<GuestFrameTextureHost> host_;
+  const blink::RemoteFrameToken guest_frame_;
+  const gfx::Size size_;
+  const base::UnguessableToken wait_key_ = base::UnguessableToken::Create();
+  scoped_refptr<viz::RasterContextProvider> context_provider_;
+  std::vector<scoped_refptr<gpu::ClientSharedImage>> images_;
+  base::ScopedClosureRunner capture_handle_;
+  base::WeakPtrFactory<GuestFrameTextureSourceHostImpl> weak_factory_{this};
+};
