From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <luke@agent54.org>
Date: Sun, 22 Nov 2026 19:22:37 +0000
Subject: [PATCH 22/50] direct route: survive GPU process loss (new ring, frames continue)

CopyNextFrame now replies a status: kSuccess, kEnded (end of stream) or
kImagesLost. The browser source host observes its GPU context
(viz::ContextLostObserver, plus GetGraphicsResetStatusKHR() when a copy comes
back empty) and replies kImagesLost after a loss. While the guest is owned
but has no surface (e.g. while viz restarts), a copy is retried every 100 ms
for up to 5 s instead of ending the stream.

New GuestFrameTextureSourceHost.Reallocate(): allocates a new ring of the
same size on the browser's current (recreated) context. The Blink source,
on kImagesLost, stops issuing copies, waits until none is pending, calls
Reallocate(), imports the new images into its own (recreated) GPU context
and continues. Replies and frame releases are tagged with a ring generation
so ones from the lost ring are ignored.

Test: ControlledFrameTextureSourceTest.GpuProcessLoss reads green frames,
kills the GPU process (content::KillGpuProcess()) and requires ten more
green frames from the same source (3/3 passes).
---
diff --git a/chrome/browser/controlled_frame/controlled_frame_apitest.cc b/chrome/browser/controlled_frame/controlled_frame_apitest.cc
--- a/chrome/browser/controlled_frame/controlled_frame_apitest.cc
+++ b/chrome/browser/controlled_frame/controlled_frame_apitest.cc
@@ -50,6 +50,7 @@
 #include "content/public/common/result_codes.h"
 #include "content/public/test/browser_test.h"
 #include "content/public/test/browser_test_utils.h"
+#include "content/public/browser/gpu_utils.h"
 #include "content/public/test/guest_frame_texture_test_util.h"
 #include "components/policy/core/common/policy_pref_names.h"
 #include "components/prefs/pref_service.h"
@@ -1140,6 +1141,53 @@
       for (const s of sources) s.close();
       return 'released';
     })();)"));
+}
+
+// When the GPU process restarts, the source gets a new ring of images and
+// continues; the stream does not end.
+IN_PROC_BROWSER_TEST_F(ControlledFrameTextureSourceTest, GpuProcessLoss) {
+  web_app::IsolatedWebAppUrlInfo url_info =
+      CreateAndInstallEmptyApp(web_app::ManifestBuilder());
+  content::RenderFrameHost* app_frame = OpenApp(url_info.app_id());
+  extensions::WebViewGuest* guest = CreateSizedFrame(
+      app_frame, embedded_https_test_server().GetURL("/index.html"));
+  ASSERT_TRUE(guest);
+  ASSERT_TRUE(content::ExecJs(guest->GetGuestMainFrame(), R"(
+    document.body.innerHTML = '';
+    let flip = false;
+    (function paint() {
+      flip = !flip;
+      document.documentElement.style.background =
+          flip ? 'rgb(0, 255, 0)' : 'rgb(0, 254, 0)';
+      requestAnimationFrame(paint);
+    })();)"));
+  ASSERT_TRUE(content::ExecJs(app_frame, kReadColorFn));
+  ASSERT_EQ("green", content::EvalJs(app_frame, R"(
+    (async () => {
+      window.src = await document.querySelector('controlledframe')
+          .createTextureSource({width: 320, height: 40});
+      return readColor(src, 'green');
+    })();)"));
+  content::KillGpuProcess();
+  // Frames read across the restart may be from the lost ring (not green);
+  // the stream must continue with green frames (ten, more than a ring holds
+  // from before the restart).
+  EXPECT_EQ("green", content::EvalJs(app_frame, R"(
+    (async () => {
+      let greens = 0;
+      for (let i = 0; i < 600; i++) {
+        let r;
+        try {
+          r = await readColor(src, 'green', 1);
+        } catch (e) {
+          continue;
+        }
+        if (r.startsWith('null')) return r;
+        if (r === 'green' && ++greens === 10) return r;
+      }
+      return greens + ' green frames after the restart';
+    })();)"));
+  ASSERT_TRUE(content::ExecJs(app_frame, "src.close();"));
 }
 
