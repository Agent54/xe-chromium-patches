       mojo::PendingReceiver<blink::mojom::GuestFrameTextureSourceHost> source,
       CreateSourceCallback callback) override;
 
diff --git a/third_party/blink/public/mojom/guest_frame_texture/guest_frame_texture.mojom b/third_party/blink/public/mojom/guest_frame_texture/guest_frame_texture.mojom
--- a/third_party/blink/public/mojom/guest_frame_texture/guest_frame_texture.mojom
+++ b/third_party/blink/public/mojom/guest_frame_texture/guest_frame_texture.mojom
@@ -21,8 +21,11 @@
   // a guest attached to a child frame of the calling frame. While the source
   // is alive the guest is treated as being captured (kept rendering and
