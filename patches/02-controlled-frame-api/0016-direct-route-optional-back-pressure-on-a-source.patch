   CreateSource(RemoteFrameToken guest_frame, gfx.mojom.Size size,
-               uint32 pool_size, bool webgpu,
+               uint32 pool_size, bool webgpu, bool backpressure,
                pending_receiver<GuestFrameTextureSourceHost> source)
       => (array<gpu.mojom.ExportedSharedImage> images,
           gpu.mojom.SyncToken creation_sync_token);
