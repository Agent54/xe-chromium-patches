From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <noreply@xe.invalid>
Date: Sun, 22 Nov 2026 18:39:50 +0000
Subject: [PATCH 19/50] direct route: GPU memory and copy quota per document and process

Each Blink source binds its own GuestFrameTextureHost, so the former limit
of 256 sources per host bounded nothing. Usage is now kept per document (a
DocumentUserData shared by all its hosts and sources) and per renderer
process: at most 256 MiB of images per source, 1 GiB per document and 2 GiB
per process, 256 sources per document, and 512 / 1024 copies in flight per
document / process. A source may have only one copy in flight per slot.
Bytes are counted from allocation until the browser drops the images.

Test: ControlledFrameTextureSourceTest.Quota (a 512 MiB source is refused;
the ninth 127 MiB source of one document is refused).
---
diff --git a/chrome/browser/controlled_frame/controlled_frame_apitest.cc b/chrome/browser/controlled_frame/controlled_frame_apitest.cc
--- a/chrome/browser/controlled_frame/controlled_frame_apitest.cc
+++ b/chrome/browser/controlled_frame/controlled_frame_apitest.cc
@@ -1062,6 +1062,51 @@
   EXPECT_FALSE(content::CanReadGuestFrameTextureForTesting(child, guest_main));
 }
 
+// The limits on GPU memory hold for a document across all of its sources
+// (each source binds its own host in the browser).
+IN_PROC_BROWSER_TEST_F(ControlledFrameTextureSourceTest, Quota) {
+  web_app::IsolatedWebAppUrlInfo url_info =
+      CreateAndInstallEmptyApp(web_app::ManifestBuilder());
+  content::RenderFrameHost* app_frame = OpenApp(url_info.app_id());
+  extensions::WebViewGuest* guest = CreateSizedFrame(
+      app_frame, embedded_https_test_server().GetURL("/index.html"));
+  ASSERT_TRUE(guest);
+  ASSERT_TRUE(content::ExecJs(guest->GetGuestMainFrame(), R"(
+    document.body.innerHTML = '';
+    let flip = false;
+    (function paint() {
+      flip = !flip;
+      document.documentElement.style.background =
+          flip ? 'rgb(0, 255, 0)' : 'rgb(0, 254, 0)';
+      requestAnimationFrame(paint);
+    })();)"));
+  EXPECT_EQ("big refused; 8 ok, then refused", content::EvalJs(app_frame, R"(
+    (async () => {
+      const f = document.querySelector('controlledframe');
+      const first = async (src) => {
+        const vf = await src.read();
+        if (!vf) return false;
+        vf.close();
+        return true;
+      };
+      // 8192x8192 x 4 bytes x 2 images = 512 MiB: over the 256 MiB limit
+      // for one source.
+      const big = await f.createTextureSource(
+          {width: 8192, height: 8192, poolSize: 2, maxInFlight: 1});
+      if (await first(big)) return 'big accepted';
+      // 1920x1080 x 4 bytes x 16 images = 126.6 MiB each; 1 GiB for the
+      // document, so the ninth is refused.
+      window.sources = [];
+      for (let i = 0; i < 12; i++) {
+        const s = await f.createTextureSource(
+            {width: 1920, height: 1080, poolSize: 16});
+        if (!(await first(s))) return `big refused; ${i} ok, then refused`;
+        sources.push(s);
+      }
+      return 'never refused';
+    })();)"));
+}
