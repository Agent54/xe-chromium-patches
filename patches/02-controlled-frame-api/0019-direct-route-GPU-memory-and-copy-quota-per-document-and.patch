+// What one document and one renderer process can make the browser allocate
+// and keep in flight, over all their sources (each Blink source binds its own
+// GuestFrameTextureHost, so these are kept outside it). Images count from
+// allocation until the browser drops them (when the source goes away, or as
+// the renderer gives up slots after Stop(); see below).
+constexpr uint64_t kMaxBytesPerSource = uint64_t{256} << 20;
+constexpr uint64_t kMaxBytesPerDocument = uint64_t{1024} << 20;
+constexpr uint64_t kMaxBytesPerProcess = uint64_t{2048} << 20;
+constexpr uint32_t kMaxSourcesPerDocument = 256;
+constexpr uint32_t kMaxOutstandingPerDocument = 512;
+constexpr uint32_t kMaxOutstandingPerProcess = 1024;
+
+struct Usage {
+  uint64_t bytes = 0;
+  uint32_t sources = 0;
+  uint32_t outstanding = 0;
+  bool empty() const { return !bytes && !sources && !outstanding; }
+};
+
+std::map<int, Usage>& ProcessUsages() {
+  static base::NoDestructor<std::map<int, Usage>> usages;
+  return *usages;
+}
+
+// Usage of one document, shared by its GuestFrameTextureHosts and their
+// sources (which can outlive the document's user data briefly), and of the
+// document's process.
+class UsageAccount : public base::RefCounted<UsageAccount> {
+ public:
+  explicit UsageAccount(int process_id) : process_id_(process_id) {}
+
+  bool TryAddSource(uint64_t bytes) {
+    Usage& process = ProcessUsages()[process_id_];
+    if (bytes > kMaxBytesPerSource ||
+        document_.sources + 1 > kMaxSourcesPerDocument ||
+        document_.bytes + bytes > kMaxBytesPerDocument ||
+        process.bytes + bytes > kMaxBytesPerProcess) {
+      MaybeErase();
+      return false;
+    }
+    document_.sources += 1;
+    process.sources += 1;
+    document_.bytes += bytes;
+    process.bytes += bytes;
+    return true;
+  }
+  void RemoveSource() {
+    document_.sources -= 1;
+    ProcessUsages()[process_id_].sources -= 1;
+    MaybeErase();
+  }
+  void RemoveBytes(uint64_t bytes) {
+    document_.bytes -= bytes;
+    ProcessUsages()[process_id_].bytes -= bytes;
+    MaybeErase();
+  }
+  bool TryBeginRequest() {
+    Usage& process = ProcessUsages()[process_id_];
+    if (document_.outstanding + 1 > kMaxOutstandingPerDocument ||
+        process.outstanding + 1 > kMaxOutstandingPerProcess) {
+      MaybeErase();
+      return false;
+    }
+    document_.outstanding += 1;
+    process.outstanding += 1;
+    return true;
+  }
+  void EndRequests(uint32_t count) {
+    document_.outstanding -= count;
+    ProcessUsages()[process_id_].outstanding -= count;
+    MaybeErase();
+  }
+
+ private:
+  friend class base::RefCounted<UsageAccount>;
+  ~UsageAccount() = default;
+  void MaybeErase() {
+    auto it = ProcessUsages().find(process_id_);
+    if (it != ProcessUsages().end() && it->second.empty()) {
+      ProcessUsages().erase(it);
+    }
+  }
+  const int process_id_;
+  Usage document_;
+};
+
+class DocumentUsage : public DocumentUserData<DocumentUsage> {
+ public:
+  ~DocumentUsage() override = default;
+  const scoped_refptr<UsageAccount>& account() const { return account_; }
+
+ private:
+  explicit DocumentUsage(RenderFrameHost* rfh)
+      : DocumentUserData(rfh),
+        account_(base::MakeRefCounted<UsageAccount>(
+            rfh->GetProcess()->GetDeprecatedID())) {}
+  friend DocumentUserData;
+  DOCUMENT_USER_DATA_KEY_DECL();
+  const scoped_refptr<UsageAccount> account_;
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(DocumentUsage);
+
+uint64_t ImageBytes(const gfx::Size& size) {
+  return uint64_t{4} * static_cast<uint64_t>(size.width()) *
+         static_cast<uint64_t>(size.height());
+}
