+// found in the LICENSE file.
+
+dictionary GuestFrameTextureSourceInit {
+  [EnforceRange] unsigned long width = 640;
+  [EnforceRange] unsigned long height = 360;
+  // 0 = no cap (one copy per new guest frame).
+  double maxFrameRate = 0;
+  // Number of shared images in the ring (frames held by script + 1 in flight).
+  [EnforceRange] unsigned long poolSize = 3;
+  // Also request WebGPU read usage on the shared images.
+  boolean webgpu = false;
+};
