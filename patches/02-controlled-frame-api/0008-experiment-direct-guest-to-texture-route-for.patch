+// static
+GuestFrameTextureSource* GuestFrameTextureSource::Create(
+    ScriptState* script_state,
+    HTMLIFrameElement* guest,
+    const GuestFrameTextureSourceInit* init,
+    ExceptionState& exception_state) {
+  auto* window = LocalDOMWindow::From(script_state);
+  if (!window || !window->GetFrame()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "No frame");
+    return nullptr;
+  }
+  Frame* content = guest ? guest->ContentFrame() : nullptr;
+  if (!content || !content->IsRemoteFrame()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "The element does not show a guest");
+    return nullptr;
+  }
+  if (!SharedGpuContext::IsGpuCompositingEnabled()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kNotSupportedError,
+                                      "GPU compositing is disabled");
+    return nullptr;
+  }
+  if (init->width() == 0 || init->height() == 0 || init->width() > 8192 ||
+      init->height() > 8192 || init->poolSize() < 2 || init->poolSize() > 16) {
+    exception_state.ThrowRangeError("Invalid size or pool size");
+    return nullptr;
+  }
+  return MakeGarbageCollected<GuestFrameTextureSource>(
+      window, content->GetFrameToken().GetAs<RemoteFrameToken>(), init);
+}
+
+GuestFrameTextureSource::GuestFrameTextureSource(
+    ExecutionContext* context,
+    const RemoteFrameToken& token,
+    const GuestFrameTextureSourceInit* init)
+    : execution_context_(context),
+      host_(context),
+      token_(token),
+      width_(init->width()),
+      height_(init->height()),
+      pool_size_(init->poolSize()),
+      webgpu_(init->webgpu()),
+      min_interval_(init->maxFrameRate() > 0
+                        ? base::Seconds(1.0 / init->maxFrameRate())
+                        : base::TimeDelta()) {
+  auto task_runner = context->GetTaskRunner(TaskType::kInternalMedia);
+  context->GetBrowserInterfaceBroker().GetInterface(
+      host_.BindNewPipeAndPassReceiver(task_runner));
+}
+
+GuestFrameTextureSource::~GuestFrameTextureSource() = default;
+
+void GuestFrameTextureSource::Trace(Visitor* visitor) const {
+  visitor->Trace(execution_context_);
+  visitor->Trace(host_);
+  visitor->Trace(pending_read_);
+  ScriptWrappable::Trace(visitor);
+}
+
+bool GuestFrameTextureSource::EnsureSlots() {
+  if (!slots_.empty()) {
+    return true;
+  }
+  auto wrapper = SharedGpuContext::ContextProviderWrapper();
+  if (!wrapper) {
+    return false;
+  }
+  gpu::SharedImageInterface* sii =
+      wrapper->ContextProvider().SharedImageInterface();
+  if (!sii) {
+    return false;
+  }
+  // Written by the display compositor (DISPLAY_WRITE, as a CopyOutputRequest
+  // blit target); read by WebGL/canvas/WebGPU imports of the VideoFrame.
+  gpu::SharedImageUsageSet usage =
+      gpu::SHARED_IMAGE_USAGE_DISPLAY_WRITE |
+      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ |
+      gpu::SHARED_IMAGE_USAGE_GLES2_READ | gpu::SHARED_IMAGE_USAGE_RASTER_READ;
+  if (webgpu_) {
+    usage |= gpu::SHARED_IMAGE_USAGE_WEBGPU_READ;
+  }
+  for (uint32_t i = 0; i < pool_size_; ++i) {
+    auto slot = base::MakeRefCounted<Slot>();
+    slot->shared_image = sii->CreateSharedImage(
+        {viz::SinglePlaneFormat::kRGBA_8888, gfx::Size(width_, height_),
+         gfx::ColorSpace::CreateSRGB(), kTopLeft_GrSurfaceOrigin,
+         kPremul_SkAlphaType, usage, "GuestFrameTextureSource"},
+        gpu::kNullSurfaceHandle);
+    if (!slot->shared_image) {
+      slots_.clear();
+      return false;
+    }
+    slots_.push_back(std::move(slot));
+  }
+  creation_token_ = sii->GenVerifiedSyncToken();
+  return true;
+}
+
+ScriptPromise<IDLNullable<VideoFrame>> GuestFrameTextureSource::read(
+    ScriptState* script_state,
+    ExceptionState& exception_state) {
+  if (pending_read_) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "A read is already pending");
+    return EmptyPromise();
+  }
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLNullable<VideoFrame>>>(
+          script_state, exception_state.GetContext());
+  auto promise = resolver->Promise();
+  if (closed_) {
+    resolver->Resolve(nullptr);
+    return promise;
+  }
+  if (!EnsureSlots()) {
+    resolver->Reject(MakeGarbageCollected<DOMException>(
+        DOMExceptionCode::kOperationError, "Could not allocate shared images"));
+    return promise;
+  }
+  pending_read_ = resolver;
+  // Rate cap: issue no earlier than `min_interval_` after the previous copy.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeDelta wait = last_issue_.is_null()
+                                   ? base::TimeDelta()
+                                   : last_issue_ + min_interval_ - now;
+  if (wait.is_positive()) {
+    copy_scheduled_ = true;
+    execution_context_->GetTaskRunner(TaskType::kInternalMedia)
+        ->PostDelayedTask(FROM_HERE,
+                          blink::BindOnce(&GuestFrameTextureSource::IssueCopy,
+                                   WrapWeakPersistent(this)),
+                          wait);
+  } else {
+    IssueCopy();
+  }
+  return promise;
+}
+
+void GuestFrameTextureSource::IssueCopy() {
+  copy_scheduled_ = false;
+  if (!pending_read_ || closed_) {
+    return;
+  }
+  scoped_refptr<Slot> slot;
+  gpu::SyncToken wait_token = creation_token_;
+  for (auto& s : slots_) {
+    base::AutoLock lock(s->lock);
+    if (!s->held) {
+      slot = s;
+      if (s->release_token.HasData()) {
+        wait_token = s->release_token;
+      }
+      // Reserved for the copy in flight.
+      s->held = true;
+      break;
+    }
+  }
+  if (!slot) {
+    pending_read_->Reject(MakeGarbageCollected<DOMException>(
+        DOMExceptionCode::kInvalidStateError,
+        "All frames are in use; close() VideoFrames you no longer need"));
+    pending_read_ = nullptr;
+    return;
+  }
+  last_issue_ = base::TimeTicks::Now();
+  const bool wait_for_new_frame = !first_;
+  first_ = false;
+  host_->CopyGuestFrame(
+      token_, slot->shared_image->Export(), wait_token,
+      gfx::Size(width_, height_), wait_for_new_frame,
+      blink::BindOnce(&GuestFrameTextureSource::OnCopied, WrapWeakPersistent(this),
+               slot));
+}
+
+void GuestFrameTextureSource::OnCopied(scoped_refptr<Slot> slot,
+                                       bool success) {
+  if (!success || closed_ || !pending_read_) {
+    {
+      base::AutoLock lock(slot->lock);
+      slot->held = false;
+    }
+    if (pending_read_) {
+      // The guest is gone (or not an owned guest): end of stream.
+      closed_ = !success || closed_;
+      pending_read_->Resolve(nullptr);
+      pending_read_ = nullptr;
+    }
+    return;
+  }
+  // The copy was flushed by the display compositor on the GPU main thread
+  // before the reply was sent; uses of the frame are ordered after it on the
+  // GPU process main thread. Wait on the creation token for the import.
+  auto release_cb = ConvertToBaseOnceCallback(CrossThreadBindOnce(
+      [](scoped_refptr<Slot> slot, const gpu::SyncToken& release_token) {
+        base::AutoLock lock(slot->lock);
+        slot->release_token = release_token;
+        slot->held = false;
+      },
+      slot));
+  auto media_frame = media::VideoFrame::WrapSharedImage(
+      media::PIXEL_FORMAT_ABGR, slot->shared_image, creation_token_,
+      std::move(release_cb), gfx::Rect(width_, height_),
+      gfx::Size(width_, height_),
+      base::TimeTicks::Now() - base::TimeTicks());
+  if (!media_frame) {
+    pending_read_->Reject(MakeGarbageCollected<DOMException>(
+        DOMExceptionCode::kOperationError, "Could not wrap frame"));
+    pending_read_ = nullptr;
+    return;
+  }
+  media_frame->set_color_space(gfx::ColorSpace::CreateSRGB());
+  auto* frame = MakeGarbageCollected<VideoFrame>(std::move(media_frame),
+                                                 execution_context_.Get());
+  pending_read_->Resolve(frame);
+  pending_read_ = nullptr;
+}
+
+void GuestFrameTextureSource::close() {
+  closed_ = true;
+  if (pending_read_) {
+    pending_read_->Resolve(nullptr);
+    pending_read_ = nullptr;
+  }
+}
