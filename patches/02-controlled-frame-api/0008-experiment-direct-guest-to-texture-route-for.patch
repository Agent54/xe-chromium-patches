+#include "base/task/single_thread_task_runner.h"
+#include "components/viz/common/frame_sinks/blit_request.h"
+#include "components/viz/common/frame_sinks/copy_output_request.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "components/viz/host/host_frame_sink_manager.h"
+#include "content/browser/compositor/surface_utils.h"
+#include "content/browser/renderer_host/frame_tree_node.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_frame_proxy_host.h"
+#include "content/browser/renderer_host/render_widget_host_view_child_frame.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "gpu/command_buffer/client/client_shared_image.h"
+
+namespace content {
+
+// static
+void GuestFrameTextureHost::Create(
+    RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<blink::mojom::GuestFrameTextureHost> receiver) {
+  base::MakeSelfDeleting<GuestFrameTextureHost>(*render_frame_host,
+                                                std::move(receiver));
+}
+
+GuestFrameTextureHost::GuestFrameTextureHost(
+    RenderFrameHost& render_frame_host,
+    mojo::PendingReceiver<blink::mojom::GuestFrameTextureHost> receiver,
+    base::SelfDeletingPassKey key)
+    : DocumentService(render_frame_host, std::move(receiver), key) {}
+
+GuestFrameTextureHost::~GuestFrameTextureHost() = default;
+
+RenderWidgetHostViewChildFrame* GuestFrameTextureHost::FindOwnedGuestView(
+    const blink::RemoteFrameToken& guest_frame) {
+  auto* rfh = static_cast<RenderFrameHostImpl*>(&render_frame_host());
+  RenderFrameProxyHost* proxy = RenderFrameProxyHost::FromFrameToken(
+      rfh->GetProcess()->GetDeprecatedID(), guest_frame);
+  if (!proxy) {
+    return nullptr;
+  }
+  FrameTreeNode* inner_root = proxy->frame_tree_node();
+  // Only the main frame of an inner WebContents (a guest), represented in
+  // the caller's process by its proxy to the outer delegate. Fenced frames
+  // and ordinary (cross-origin) iframes are refused.
+  if (!inner_root->IsMainFrame() || inner_root->IsFencedFrameRoot() ||
+      !inner_root->render_manager()->IsMainFrameForInnerDelegate() ||
+      inner_root->render_manager()->GetProxyToOuterDelegate() != proxy) {
+    return nullptr;
+  }
+  FrameTreeNode* outer_delegate =
+      inner_root->render_manager()->GetOuterDelegateNode();
+  if (!outer_delegate || outer_delegate->parent() != rfh) {
+    return nullptr;
+  }
+  auto* guest_contents = WebContentsImpl::FromFrameTreeNode(inner_root);
+  if (!guest_contents || !guest_contents->IsInnerWebContentsForGuest()) {
+    return nullptr;
+  }
+  auto* view = inner_root->current_frame_host()->GetView();
+  if (!view || !view->IsRenderWidgetHostViewChildFrame()) {
+    return nullptr;
+  }
+  return static_cast<RenderWidgetHostViewChildFrame*>(view);
+}
+
+void GuestFrameTextureHost::CopyGuestFrame(
+    const blink::RemoteFrameToken& guest_frame,
+    gpu::ExportedSharedImage destination,
+    const gpu::SyncToken& sync_token,
+    const gfx::Size& size,
+    bool wait_for_new_frame,
+    CopyGuestFrameCallback callback) {
+  RenderWidgetHostViewChildFrame* view = FindOwnedGuestView(guest_frame);
+  if (!view || !view->IsSurfaceAvailableForCopy() || size.IsEmpty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const gfx::Size source_size = view->GetCompositorViewportPixelSize();
+  if (source_size.IsEmpty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  scoped_refptr<gpu::ClientSharedImage> shared_image =
+      gpu::ClientSharedImage::ImportUnowned(std::move(destination));
+  if (!shared_image ||
+      !gfx::Rect(shared_image->size()).Contains(gfx::Rect(size))) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSharedImage,
+      base::BindOnce(
+          [](CopyGuestFrameCallback callback,
+             std::unique_ptr<viz::CopyOutputResult> result) {
+            std::move(callback).Run(!result->IsEmpty());
+          },
+          std::move(callback)));
+  request->set_result_task_runner(
+      base::SingleThreadTaskRunner::GetCurrentDefault());
+  request->set_area(gfx::Rect(source_size));
+  request->set_result_selection(gfx::Rect(size));
+  request->SetScaleRatio(
+      gfx::Vector2d(source_size.width(), source_size.height()),
+      gfx::Vector2d(size.width(), size.height()));
+  request->set_blit_request(viz::BlitRequest(
+      gfx::Point(), viz::LetterboxingBehavior::kDoNotLetterbox,
+      std::move(shared_image), sync_token,
+      /*populates_mappable_shared_image=*/false));
+  request->set_wait_for_new_frame(wait_for_new_frame);
+
+  GetHostFrameSinkManager()->RequestCopyOfOutput(
+      view->GetCurrentSurfaceId(), std::move(request),
+      /*capture_exact_surface_id=*/false, base::TimeDelta());
+}
+
+}  // namespace content
