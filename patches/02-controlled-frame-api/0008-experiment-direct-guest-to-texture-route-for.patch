+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module blink.mojom;
+
+import "gpu/ipc/common/exported_shared_image.mojom";
+import "gpu/ipc/common/sync_token.mojom";
+import "third_party/blink/public/mojom/tokens/tokens.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+// Experiment: lets an embedder frame get the pixels of a guest
+// (an inner WebContents attached to one of its child frames, e.g. a
+// <controlledframe>) copied by the display compositor into a shared image the
+// embedder owns, without a readback. Bound per RenderFrameHost.
+interface GuestFrameTextureHost {
+  // Copies the guest shown in the child remote frame `guest_frame`, scaled to
+  // `size`, into `destination` (RGBA, at least `size`), after waiting on
+  // `sync_token`. If `wait_for_new_frame`, the copy is taken from the guest's
+  // next new frame (damage-driven). Replies `success` = false if the frame is
+  // not an inner guest of the calling frame, has no surface, or went away.
+  CopyGuestFrame(RemoteFrameToken guest_frame,
+                 gpu.mojom.ExportedSharedImage destination,
+                 gpu.mojom.SyncToken sync_token,
+                 gfx.mojom.Size size,
+                 bool wait_for_new_frame) => (bool success);
+};
