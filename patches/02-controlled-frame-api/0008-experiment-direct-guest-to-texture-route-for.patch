+namespace blink {
+
+class ExceptionState;
+class ExecutionContext;
+class GuestFrameTextureSourceInit;
+class HTMLIFrameElement;
+class ScriptState;
+class VideoFrame;
+
+// Experiment. See guest_frame_texture_source.idl.
+class MODULES_EXPORT GuestFrameTextureSource final : public ScriptWrappable {
+  DEFINE_WRAPPERTYPEINFO();
+
+ public:
+  static GuestFrameTextureSource* Create(ScriptState*,
+                                         HTMLIFrameElement* guest,
+                                         const GuestFrameTextureSourceInit*,
+                                         ExceptionState&);
+
+  GuestFrameTextureSource(ExecutionContext*,
+                          const RemoteFrameToken& token,
+                          const GuestFrameTextureSourceInit*);
+  ~GuestFrameTextureSource() override;
+
+  ScriptPromise<IDLNullable<VideoFrame>> read(ScriptState*, ExceptionState&);
+  void close();
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+
+  void Trace(Visitor*) const override;
+
+ private:
+  // A shared image of the ring, shared with the release callbacks of the
+  // VideoFrames handed to script (which may run on other threads).
+  struct Slot : public base::RefCountedThreadSafe<Slot> {
+    scoped_refptr<gpu::ClientSharedImage> shared_image;
+    base::Lock lock;
+    bool held = false;            // GUARDED_BY(lock): a VideoFrame wraps it.
+    gpu::SyncToken release_token;  // GUARDED_BY(lock)
+
+   private:
+    friend class base::RefCountedThreadSafe<Slot>;
+    ~Slot() = default;
+  };
+
+  bool EnsureSlots();
+  void IssueCopy();
+  void OnCopied(scoped_refptr<Slot> slot, bool success);
+
+  Member<ExecutionContext> execution_context_;
+  HeapMojoRemote<mojom::blink::GuestFrameTextureHost> host_;
+  RemoteFrameToken token_;
+  uint32_t width_;
+  uint32_t height_;
+  uint32_t pool_size_;
+  bool webgpu_;
+  base::TimeDelta min_interval_;
+  base::TimeTicks last_issue_;
+  bool first_ = true;
+  bool closed_ = false;
+  bool copy_scheduled_ = false;
+  gpu::SyncToken creation_token_;
+  Vector<scoped_refptr<Slot>> slots_;
+  Member<ScriptPromiseResolver<IDLNullable<VideoFrame>>> pending_read_;
+};
+
+}  // namespace blink
