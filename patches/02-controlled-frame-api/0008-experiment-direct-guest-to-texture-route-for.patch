+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Experiment: GPU-side copies of a guest (<controlledframe>) as
+// VideoFrames backed by shared images. Construct with the guest's internal
+// <iframe>; the browser only accepts a guest owned by the calling document.
+[
+    Exposed=Window,
+    IsolatedContext
+] interface GuestFrameTextureSource {
+  [CallWith=ScriptState, RaisesException]
+  constructor(HTMLIFrameElement guest, optional GuestFrameTextureSourceInit init = {});
+
+  // Resolves with a VideoFrame holding the guest's next new frame (or the
+  // current one for the first call), or null once the guest is gone.
+  [CallWith=ScriptState, RaisesException] Promise<VideoFrame?> read();
+
+  void close();
+
+  readonly attribute unsigned long width;
+  readonly attribute unsigned long height;
+};
