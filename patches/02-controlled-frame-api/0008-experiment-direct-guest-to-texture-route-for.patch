+#ifndef CONTENT_BROWSER_RENDERER_HOST_GUEST_FRAME_TEXTURE_HOST_H_
+#define CONTENT_BROWSER_RENDERER_HOST_GUEST_FRAME_TEXTURE_HOST_H_
+
+#include "base/memory/self_deleting.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/document_service.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "third_party/blink/public/mojom/guest_frame_texture/guest_frame_texture.mojom.h"
+
+namespace content {
+
+class RenderFrameHost;
+class RenderWidgetHostViewChildFrame;
+
+// Experiment. Copies a guest's surface (an inner WebContents attached
+// to a child frame of the calling document, e.g. a <controlledframe>) into a
+// shared image owned by the calling renderer, via a viz CopyOutputRequest
+// with a BlitRequest: GPU only, no readback, no media capture device.
+class GuestFrameTextureHost final
+    : public DocumentService<blink::mojom::GuestFrameTextureHost> {
+ public:
+  static void Create(
+      RenderFrameHost* render_frame_host,
+      mojo::PendingReceiver<blink::mojom::GuestFrameTextureHost> receiver);
+
+  GuestFrameTextureHost(
+      RenderFrameHost& render_frame_host,
+      mojo::PendingReceiver<blink::mojom::GuestFrameTextureHost> receiver,
+      base::SelfDeletingPassKey key);
+
+  // blink::mojom::GuestFrameTextureHost:
+  void CopyGuestFrame(const blink::RemoteFrameToken& guest_frame,
+                      gpu::ExportedSharedImage destination,
+                      const gpu::SyncToken& sync_token,
+                      const gfx::Size& size,
+                      bool wait_for_new_frame,
+                      CopyGuestFrameCallback callback) override;
+
+ private:
+  ~GuestFrameTextureHost() final;
+
+  // Returns the guest's view if `guest_frame` is the proxy of an inner
+  // (guest) WebContents' main frame whose outer delegate frame is a child of
+  // this document's frame; nullptr otherwise.
+  RenderWidgetHostViewChildFrame* FindOwnedGuestView(
+      const blink::RemoteFrameToken& guest_frame);
+
+  base::WeakPtrFactory<GuestFrameTextureHost> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_RENDERER_HOST_GUEST_FRAME_TEXTURE_HOST_H_
