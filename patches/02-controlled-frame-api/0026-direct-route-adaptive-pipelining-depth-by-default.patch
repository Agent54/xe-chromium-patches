+}
+
+// Adaptive pipelining depth. One copy at a time gives the lowest latency
+// while a copy comes back (including the wait for the guest's next frame)
+// within two frame intervals; when the round trip is longer, guest frames are
+// missed unless more copies are kept requested. Only copies issued while no
+// other was pending are measured (one queued behind another measures the
+// queue, not the path). Going deeper is held for `depth_hold_` (2 s, doubling
+// to 16 s); then depth 1 is probed with four single-copy samples, and kept
+// if the round trip stayed short. Thresholds have 4 ms of hysteresis around
+// each two-frame step.
+void GuestFrameTextureSource::UpdateAdaptiveDepth(base::TimeDelta rtt) {
+  copy_round_trip_ = single_samples_ == 0
+                         ? rtt
+                         : (copy_round_trip_ * 3 + rtt) / 4;
+  ++single_samples_;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeDelta kStep = base::Hertz(30);
+  const base::TimeDelta kHysteresis = base::Milliseconds(4);
+  const wtf_size_t up = std::clamp<wtf_size_t>(
+      1 + static_cast<wtf_size_t>(
+              std::max(base::TimeDelta(), copy_round_trip_ - kHysteresis) /
+              kStep),
+      1, max_in_flight_);
+  if (adaptive_depth_ == 1) {
+    if (single_samples_ >= 4 && up > 1) {
+      if (probing_) {
+        // The probe failed: stay deep for longer before probing again.
+        depth_hold_ = std::min(depth_hold_ * 2, base::Seconds(16));
+      }
+      adaptive_depth_ = up;
+      depth_since_ = now;
+    } else if (probing_ && single_samples_ >= 4) {
+      depth_hold_ = base::Seconds(2);
+    }
+    if (single_samples_ >= 4) {
+      probing_ = false;
+    }
+    return;
+  }
+  const wtf_size_t down = std::clamp<wtf_size_t>(
+      1 + static_cast<wtf_size_t>((copy_round_trip_ + kHysteresis) / kStep), 1,
+      max_in_flight_);
+  if (up > adaptive_depth_ || down < adaptive_depth_) {
+    adaptive_depth_ = std::max<wtf_size_t>(down, 1);
+  }
+}
+
+void GuestFrameTextureSource::MaybeProbeDepth() {
+  if (fixed_depth_ || adaptive_depth_ == 1 ||
+      base::TimeTicks::Now() - depth_since_ < depth_hold_) {
+    return;
+  }
+  adaptive_depth_ = 1;
+  probing_ = true;
+  single_samples_ = 0;
 }
 
