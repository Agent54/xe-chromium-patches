-                                                     base::Hertz(30)),
-                         1, max_in_flight_);
+  MaybeProbeDepth();
+  // Keep up to `depth` copies requested at a time (see UpdateAdaptiveDepth()
+  // for the adaptive case).
+  const wtf_size_t depth = fixed_depth_ ? fixed_depth_ : adaptive_depth_;
   while (true) {
     const wtf_size_t copying = CountIn(SlotState::kCopying);
     const wtf_size_t ready = CountIn(SlotState::kReady);
@@ -272,6 +263,9 @@
