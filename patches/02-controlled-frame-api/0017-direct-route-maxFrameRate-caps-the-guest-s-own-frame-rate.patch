-  void SetGuestInterval(base::TimeDelta interval) {
+  // Applies max(`interval`, the maxFrameRate cap) as this source's request
+  // for the guest's frame interval (zero = none); the registry combines it
+  // with other requesters (embedder setFrameRate(), other sources).
+  void SetGuestInterval(base::TimeDelta requested) {
+    const base::TimeDelta interval = std::max(requested, cap_interval_);
     RenderWidgetHostViewChildFrame* view =
         host_ ? host_->FindOwnedGuestView(guest_frame_) : nullptr;
     const viz::FrameSinkId sink =
         view ? view->GetFrameSinkId() : viz::FrameSinkId();
     if (throttled_sink_.is_valid() && throttled_sink_ != sink) {
-      GetHostFrameSinkManager()->SetFrameSinkThrottleInterval(
-          throttled_sink_, base::TimeDelta());
+      SetFrameSinkIntervalForRequester(throttled_sink_, this,
+                                       base::TimeDelta());
       throttled_sink_ = viz::FrameSinkId();
     }
-    if (!sink.is_valid() || !GetHostFrameSinkManager()) {
+    if (!sink.is_valid()) {
       return;
     }
     if (interval.is_zero() && !throttled_sink_.is_valid()) {
       return;
     }
-    GetHostFrameSinkManager()->SetFrameSinkThrottleInterval(sink, interval);
+    SetFrameSinkIntervalForRequester(sink, this, interval);
     throttled_sink_ = interval.is_zero() ? viz::FrameSinkId() : sink;
   }
 
