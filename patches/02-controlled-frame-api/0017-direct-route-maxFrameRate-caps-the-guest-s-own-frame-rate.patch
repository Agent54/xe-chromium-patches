diff --git a/content/browser/renderer_host/frame_sink_interval_registry.cc b/content/browser/renderer_host/frame_sink_interval_registry.cc
new file mode 100644
--- /dev/null
+++ b/content/browser/renderer_host/frame_sink_interval_registry.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/renderer_host/frame_sink_interval_registry.h"
+
+#include <map>
+
+#include "base/no_destructor.h"
+#include "components/viz/host/host_frame_sink_manager.h"
+#include "content/browser/compositor/surface_utils.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace content {
+
+void SetFrameSinkIntervalForRequester(const viz::FrameSinkId& frame_sink_id,
+                                      const void* requester,
+                                      base::TimeDelta interval) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  static base::NoDestructor<
+      std::map<viz::FrameSinkId, std::map<const void*, base::TimeDelta>>>
+      requests;
+  if (!frame_sink_id.is_valid()) {
+    return;
+  }
+  auto& per_sink = (*requests)[frame_sink_id];
+  if (interval.is_positive()) {
+    per_sink[requester] = interval;
+  } else {
+    per_sink.erase(requester);
+  }
+  base::TimeDelta effective;
+  for (const auto& [unused, requested] : per_sink) {
+    effective = std::max(effective, requested);
+  }
+  if (per_sink.empty()) {
+    requests->erase(frame_sink_id);
+  }
+  if (auto* manager = GetHostFrameSinkManager()) {
+    manager->SetFrameSinkThrottleInterval(frame_sink_id, effective);
+  }
+}
+
+}  // namespace content
diff --git a/content/browser/renderer_host/frame_sink_interval_registry.h b/content/browser/renderer_host/frame_sink_interval_registry.h
