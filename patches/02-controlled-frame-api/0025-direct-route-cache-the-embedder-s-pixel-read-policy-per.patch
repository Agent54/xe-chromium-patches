+  bool MayReadPixels(WebContents* guest);
+
+  // Incremented by NotifyGuestFramePixelsPolicyChanged().
+  static uint64_t GuestFramePixelsPolicyGeneration();
 
   // Test-only: whether `caller` passes the ownership check for the guest
   // whose main frame is `guest_main_frame`, using the token of the guest's
