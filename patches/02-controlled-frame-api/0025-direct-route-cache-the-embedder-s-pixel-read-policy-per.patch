+#ifndef CONTENT_PUBLIC_BROWSER_GUEST_FRAME_PIXELS_POLICY_H_
+#define CONTENT_PUBLIC_BROWSER_GUEST_FRAME_PIXELS_POLICY_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+// Experiment: the embedder calls this when anything that
+// ContentBrowserClient::MayReadGuestFramePixels() depends on may have changed
+// (e.g. a screenshot policy). Readers cache that answer per source and ask
+// again before their next copy.
+CONTENT_EXPORT void NotifyGuestFramePixelsPolicyChanged();
+
+}  // namespace content
