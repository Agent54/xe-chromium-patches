   // The ownership check used for every request, for a given calling frame.
   static RenderWidgetHostViewChildFrame* FindOwnedGuestViewForFrame(
       RenderFrameHost* caller,
       const blink::RemoteFrameToken& guest_frame,
-      WebContentsImpl** guest_contents_out = nullptr);
