From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <luke@agent54.org>
Date: Sun, 22 Nov 2026 14:44:53 +0000
Subject: [PATCH 9/50] direct route hardening (viz): per-request new-frame key, copy sync token

- CopyOutputRequest::wait_for_new_frame_key (UnguessableToken) replaces the
  per-frame-sink bool: CompositorFrameSinkSupport remembers per key the last
  activation it copied; a request is taken at once if a newer frame has
  activated and no older request of the key waits, otherwise when the next
  frame activates, releasing one request per key per activation. Two
  sources on one guest no longer starve each other, and several in-flight
  requests of one source get successive frames.
- For a keyed copy into a non-mappable blit destination,
  SkiaOutputSurfaceImpl generates a sync token, flushes the GPU tasks with
  it released right after the copy task, and the result carries it
  (CopyOutputResult::sync_token, serialized in viz.mojom.CopyOutputResult).
---
diff --git a/components/viz/common/frame_sinks/copy_output_request.h b/components/viz/common/frame_sinks/copy_output_request.h
--- a/components/viz/common/frame_sinks/copy_output_request.h
+++ b/components/viz/common/frame_sinks/copy_output_request.h
@@ -152,11 +152,27 @@
   void set_is_secure(bool is_secure) { is_secure_ = is_secure; }
   bool is_secure() const { return is_secure_; }
 
-  // Experiment: if true, a request sent to a frame sink is held
-  // until the sink activates its next CompositorFrame (i.e. new content),
-  // instead of being satisfied from the current frame.
-  void set_wait_for_new_frame(bool wait) { wait_for_new_frame_ = wait; }
-  bool wait_for_new_frame() const { return wait_for_new_frame_; }
+  // Experiment: if set, a request sent to a frame sink is satisfied
+  // from a frame newer than the one the previous request with the same key
+  // copied (held until such a frame activates). Requests with the same key
+  // get distinct, successive frames.
+  void set_wait_for_new_frame_key(
+      std::optional<base::UnguessableToken> key) {
+    wait_for_new_frame_key_ = std::move(key);
+  }
+  const std::optional<base::UnguessableToken>& wait_for_new_frame_key() const {
+    return wait_for_new_frame_key_;
+  }
+
+  // Experiment (viz-internal, not serialized): sync token released on
+  // the display compositor's GPU sequence after the copy into a non-mappable
+  // blit destination; returned in the result's sync_token().
+  void set_release_sync_token(const gpu::SyncToken& token) {
+    release_sync_token_ = token;
+  }
+  const gpu::SyncToken& release_sync_token() const {
+    return release_sync_token_;
+  }
 
   // Sends the result from executing this request. Called by the internal
   // implementation, usually a DirectRenderer.
@@ -195,7 +211,8 @@
   std::optional<BlitRequest> blit_request_;
 
   bool is_secure_ = false;
-  bool wait_for_new_frame_ = false;
+  std::optional<base::UnguessableToken> wait_for_new_frame_key_;
+  gpu::SyncToken release_sync_token_;
 };
 
 }  // namespace viz
diff --git a/components/viz/common/frame_sinks/copy_output_result.h b/components/viz/common/frame_sinks/copy_output_result.h
--- a/components/viz/common/frame_sinks/copy_output_result.h
+++ b/components/viz/common/frame_sinks/copy_output_result.h
@@ -20,6 +20,7 @@
 #include "gpu/command_buffer/client/client_shared_image.h"
 #include "gpu/command_buffer/client/shared_image_interface.h"
 #include "gpu/command_buffer/common/mailbox.h"
+#include "gpu/command_buffer/common/sync_token.h"
 #include "third_party/skia/include/core/SkBitmap.h"
 #include "ui/gfx/color_space.h"
 #include "ui/gfx/geometry/rect.h"
@@ -218,6 +219,12 @@
     return tracked_element_rects_;
   }
 
+  // Experiment: for kSharedImage results written into a caller's
+  // blit destination, a sync token released after the GPU work that wrote
+  // it (empty if not provided). Readers of the destination wait on it.
+  void set_sync_token(const gpu::SyncToken& token) { sync_token_ = token; }
+  const gpu::SyncToken& sync_token() const { return sync_token_; }
+
  protected:
   // Lock the content of SkBitmap returned from AsSkBitmap() call.
   // Return true, if lock operation is successful, implementations should
@@ -253,6 +260,7 @@
   mutable SkBitmap cached_bitmap_;
 
   TrackedElementRects tracked_element_rects_;
+  gpu::SyncToken sync_token_;
 };
 
 // Subclass of CopyOutputResult that provides a RGBA result from an
diff --git a/components/viz/service/display_embedder/skia_output_surface_impl.cc b/components/viz/service/display_embedder/skia_output_surface_impl.cc
--- a/components/viz/service/display_embedder/skia_output_surface_impl.cc
+++ b/components/viz/service/display_embedder/skia_output_surface_impl.cc
@@ -1042,12 +1042,27 @@
                                  sync_tokens.begin(), sync_tokens.end());
   }
 
+  // Experiment: give a copy into a caller's non-mappable blit
+  // destination a sync token that is released right after the GPU task that
+  // writes it, so the caller's readers can wait on it.
+  gpu::SyncToken copy_release_token;
+  if (request->has_blit_request() &&
+      !request->blit_request().populates_mappable_shared_image() &&
+      request->wait_for_new_frame_key()) {
+    copy_release_token = shared_image_interface_->GenNextSyncToken();
+    copy_release_token.SetVerifyFlush();
+    request->set_release_sync_token(copy_release_token);
+  }
+
   auto callback = base::BindOnce(&SkiaOutputSurfaceImplOnGpu::CopyOutput,
                                  base::Unretained(impl_on_gpu_.get()), geometry,
                                  color_space, std::move(request), mailbox,
                                  std::move(release_callback));
   EnqueueGpuTask(std::move(callback), std::move(resource_sync_tokens_),
                  /*make_current=*/true, /*need_framebuffer=*/mailbox.IsZero());
+  if (copy_release_token.HasData()) {
+    FlushGpuTasks(SyncMode::kNoWait, copy_release_token);
+  }
 }
 
