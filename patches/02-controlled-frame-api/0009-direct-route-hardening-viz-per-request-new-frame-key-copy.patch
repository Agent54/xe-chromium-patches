diff --git a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
--- a/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
+++ b/components/viz/service/display_embedder/skia_output_surface_impl_on_gpu.cc
@@ -1106,10 +1106,14 @@
     scoped_write.reset();
 
     if (request->has_blit_request()) {
-      request->SendResult(std::make_unique<CopyOutputSharedImageResult>(
+      auto result = std::make_unique<CopyOutputSharedImageResult>(
           CopyOutputResult::Format::RGBA, geometry.result_selection,
           request->blit_request().shared_image(),
-          std::move(blit_release_callback)));
+          std::move(blit_release_callback));
+      // Experiment: released after this GPU task (see
+      // SkiaOutputSurfaceImpl::CopyOutput).
+      result->set_sync_token(request->release_sync_token());
+      request->SendResult(std::move(result));
     } else {
       DCHECK(!blit_release_callback);
       // Grab the mailbox before we transfer `representation`'s ownership:
diff --git a/components/viz/service/frame_sinks/compositor_frame_sink_support.cc b/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
--- a/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
+++ b/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
@@ -310,14 +310,24 @@
   // Experiment: a new frame activated; release the requests that
   // waited for one. The surface has damage, so it is aggregated (and the
   // requests taken) in the next display frame that draws it.
+  // Per key, release only the oldest waiting request, so that several
+  // requests of one key get successive frames.
   ++activation_count_;
   if (!deferred_copy_output_requests_.empty()) {
-    last_copied_activation_count_ = activation_count_;
+    base::flat_set<base::UnguessableToken> released_keys;
+    std::vector<std::unique_ptr<PendingCopyOutputRequest>> still_waiting;
+    for (auto& request : deferred_copy_output_requests_) {
+      const base::UnguessableToken& key =
+          *request->copy_output_request->wait_for_new_frame_key();
+      if (released_keys.insert(key).second) {
+        last_copied_activation_by_key_[key] = activation_count_;
+        copy_output_requests_.push_back(std::move(request));
+      } else {
+        still_waiting.push_back(std::move(request));
+      }
+    }
+    deferred_copy_output_requests_ = std::move(still_waiting);
   }
-  for (auto& request : deferred_copy_output_requests_) {
-    copy_output_requests_.push_back(std::move(request));
-  }
-  deferred_copy_output_requests_.clear();
 
   const CompositorFrameMetadata& active_frame_metadata =
       surface->GetActiveFrameMetadata();
@@ -1458,16 +1468,26 @@
 
 void CompositorFrameSinkSupport::RequestCopyOfOutput(
     std::unique_ptr<PendingCopyOutputRequest> pending_copy_output_request) {
-  if (pending_copy_output_request->copy_output_request->wait_for_new_frame()) {
+  if (const auto& key = pending_copy_output_request->copy_output_request
+                            ->wait_for_new_frame_key()) {
     // Experiment: satisfied from a frame newer than the one the
-    // previous such request copied: right away if one has activated since,
-    // otherwise when the next one activates.
-    if (activation_count_ == last_copied_activation_count_) {
+    // previous request with this key copied: right away if one has activated
+    // since (and no older request of this key is waiting), otherwise when the
+    // next one activates.
+    auto it = last_copied_activation_by_key_.find(*key);
+    const bool newer_available =
+        it == last_copied_activation_by_key_.end() ||
+        it->second < activation_count_;
+    const bool key_waiting = std::ranges::any_of(
+        deferred_copy_output_requests_, [&](const auto& r) {
+          return *r->copy_output_request->wait_for_new_frame_key() == *key;
+        });
+    if (!newer_available || key_waiting) {
       deferred_copy_output_requests_.push_back(
           std::move(pending_copy_output_request));
       return;
     }
-    last_copied_activation_count_ = activation_count_;
+    last_copied_activation_by_key_[*key] = activation_count_;
   }
   copy_output_requests_.push_back(std::move(pending_copy_output_request));
   if (last_activated_surface_id_.is_valid()) {
@@ -1848,6 +1868,7 @@
   // return an empty bitmap, signalling that the request is never satisfied.
   copy_output_requests_.clear();
   deferred_copy_output_requests_.clear();
+  last_copied_activation_by_key_.clear();
 }
 
