+// Moving a <webview>, or one of its ancestors, with Node.moveBefore() must
+// keep the element bound to its existing guest. If a move rebinds the element,
+// the element drops its guest synchronously within moveBefore(), so the
+// contentWindow check fails without waiting on a script call that would never
+// complete. The browser side checks the guest count.
+async function testMoveBeforeKeepsGuest() {
+  const webview = document.createElement('webview');
+  webview.setAttribute('partition', 'testMoveBeforeKeepsGuest');
+  const container = document.createElement('div');
+  const otherContainer = document.createElement('div');
+  document.body.append(container, otherContainer);
+  const loaded = new Promise((resolve) => {
+    webview.addEventListener('loadstop', resolve, {once: true});
+  });
+  webview.setAttribute('src', 'data:text/html,<body>guest</body>');
+  container.appendChild(webview);
+  await loaded;
+
+  // Mark the guest's document. executeScript() runs in an isolated world, so
+  // the marker is kept in the DOM, which all worlds share.
+  await executeScriptP(webview, {
+    code: 'document.documentElement.setAttribute("data-marker", "original");'
+  });
+  const originalWindow = webview.contentWindow;
+  const moves = [
+    () => container.moveBefore(webview, null),
+    () => otherContainer.moveBefore(webview, null),
+    () => container.moveBefore(otherContainer, null),
+  ];
+  for (const move of moves) {
+    move();
+    if (webview.contentWindow !== originalWindow) {
+      console.log('contentWindow changed after moveBefore()');
+      embedder.test.fail();
+      return;
+    }
+    const results = await executeScriptP(webview, {
+      code: 'document.documentElement.getAttribute("data-marker");'
+    });
+    if (!results || results[0] !== 'original') {
+      console.log('unexpected marker: ' + JSON.stringify(results));
+      embedder.test.fail();
+      return;
+    }
+  }
+  embedder.test.succeed();
+}
