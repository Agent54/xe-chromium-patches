+class ControlledFrameMoveBeforeTest : public ControlledFrameApiTest {
+ public:
+  void SetUpOnMainThread() override {
+    ControlledFrameApiTest::SetUpOnMainThread();
+    guest_view_manager_ = factory_.GetOrCreateTestGuestViewManager(
+        profile(), extensions::ExtensionsAPIClient::Get()
+                       ->CreateGuestViewManagerDelegate());
+  }
+
+  void TearDownOnMainThread() override {
+    guest_view_manager_ = nullptr;
+    ControlledFrameApiTest::TearDownOnMainThread();
+  }
+
+ protected:
+  guest_view::TestGuestViewManager* guest_view_manager() {
+    return guest_view_manager_;
+  }
+
+ private:
+  guest_view::TestGuestViewManagerFactory factory_;
+  raw_ptr<guest_view::TestGuestViewManager> guest_view_manager_ = nullptr;
+};
+
+// Moving a <controlledframe>, or one of its ancestors, with Node.moveBefore()
+// must keep the element bound to its existing guest. It must not create a
+// second guest or rebind the element's API to one.
+IN_PROC_BROWSER_TEST_F(ControlledFrameMoveBeforeTest, MoveBeforeKeepsGuest) {
+  std::unique_ptr<web_app::ScopedBundledIsolatedWebApp> app =
+      web_app::IsolatedWebAppBuilder(
+          web_app::ManifestBuilder().AddPermissionsPolicy(
+              network::mojom::PermissionsPolicyFeature::kControlledFrame,
+              /*self=*/true,
+              /*origins=*/{}))
+          .BuildBundle();
+  app->TrustSigningKey();
+  ASSERT_OK_AND_ASSIGN(web_app::IsolatedWebAppUrlInfo url_info,
+                       app->Install(profile()));
+  content::RenderFrameHost* app_frame = OpenApp(url_info.app_id());
+
+  ASSERT_TRUE(CreateControlledFrame(
+      app_frame, embedded_https_test_server().GetURL("/index.html")));
+  extensions::WebViewGuest* original_guest = GetWebViewGuest(app_frame);
+  ASSERT_TRUE(original_guest);
+  ASSERT_EQ(1u, guest_view_manager()->num_guests_created());
+  const int original_guest_instance_id = original_guest->guest_instance_id();
+
+  // Mark the original guest's document. ExecJs() runs in the guest's main
+  // world and executeScript() in an isolated world, so the marker is kept in
+  // the DOM, which both worlds share.
+  ASSERT_TRUE(content::ExecJs(
+      original_guest->GetGuestMainFrame(),
+      "document.documentElement.setAttribute('data-marker', 'original');"));
+  ASSERT_TRUE(content::ExecJs(app_frame, R"(
+    window.readMarker = async function() {
+      const frame = document.getElementsByTagName('controlledframe')[0];
+      try {
+        const [marker] = await frame.executeScript({
+          code: 'document.documentElement.getAttribute("data-marker")'
+        });
+        return String(marker);
+      } catch (e) {
+        return 'error: ' + e;
+      }
+    };
+  )"));
+  // The element's API reaches the marked document before any move.
+  ASSERT_EQ("original", content::EvalJs(app_frame, "readMarker()"));
+
+  // Move the element within its parent, to another parent, and move one of
+  // its ancestors. After each move, the element must keep its contentWindow
+  // and its API must still reach the marked document. If a move rebinds the
+  // element, the element drops its guest synchronously within moveBefore(), so
+  // the contentWindow check fails without waiting on a script call that would
+  // never complete.
+  ASSERT_EQ("original,original,original", content::EvalJs(app_frame, R"(
+    (async function() {
+      const frame = document.getElementsByTagName('controlledframe')[0];
+      const originalWindow = frame.contentWindow;
+      const container = document.createElement('div');
+      const otherContainer = document.createElement('div');
+      document.body.append(container, otherContainer);
+      const moves = [
+        () => frame.parentNode.moveBefore(frame, null),
+        () => container.moveBefore(frame, null),
+        () => otherContainer.moveBefore(container, null),
+      ];
+      const markers = [];
+      for (const move of moves) {
+        move();
+        if (frame.contentWindow !== originalWindow) {
+          markers.push('contentWindow changed');
+          break;
+        }
+        markers.push(await readMarker());
+      }
+      return markers.join();
+    })();
+  )"));
+
+  // No other guest was created, and the original guest is still the attached
+  // guest of the element. `original_guest` is not used after the moves: if
+  // the moves destroyed or replaced it, the pointer would be stale.
+  ASSERT_EQ(1u, guest_view_manager()->num_guests_created());
+  ASSERT_EQ(1u, guest_view_manager()->GetCurrentGuestCount());
+  extensions::WebViewGuest* current_guest = GetWebViewGuest(app_frame);
+  ASSERT_TRUE(current_guest);
+  ASSERT_EQ(original_guest_instance_id, current_guest->guest_instance_id());
+  EXPECT_TRUE(current_guest->attached());
+
+  // Removing the element still destroys the guest. Exactly one guest exists
+  // here, so waiting for all guests waits for this one.
+  ASSERT_TRUE(content::ExecJs(
+      app_frame,
+      "document.getElementsByTagName('controlledframe')[0].remove();"));
+  guest_view_manager()->WaitForAllGuestsDeleted();
+  EXPECT_EQ(0u, guest_view_manager()->GetCurrentGuestCount());
 }
 
