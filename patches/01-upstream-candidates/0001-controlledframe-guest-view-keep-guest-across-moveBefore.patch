+// Moving an <extensionoptions>, or one of its ancestors, with Node.moveBefore()
+// must keep the element bound to its existing guest and must not create a
+// second guest.
+IN_PROC_BROWSER_TEST_P(ExtensionWebUIEmbeddedOptionsTest,
+                       MoveBeforeKeepsGuest) {
+  const Extension* extension =
+      LoadExtension(test_data_dir_.AppendASCII("extension_options")
+                        .AppendASCII("extension_with_options_page"));
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(OpenExtensionOptions(extension));
+  ASSERT_EQ(1u, guest_view_manager()->num_guests_created());
+  const int guest_instance_id =
+      guest_view_manager()->GetLastGuestViewCreated()->guest_instance_id();
+
+  content::WebContents* webui = GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(webui, R"(
+    (() => {
+      const options = document.querySelector('extensionoptions');
+      const container = document.createElement('div');
+      const otherContainer = document.createElement('div');
+      document.body.append(container, otherContainer);
+      options.parentNode.moveBefore(options, null);
+      container.moveBefore(options, null);
+      otherContainer.moveBefore(container, null);
+    })();
+  )"));
+
+  // Embed a second <extensionoptions> and wait until it has loaded. The
+  // embedder requests its guests in order, so a guest requested by the moves
+  // would already exist by then.
+  static constexpr char kEmbedProbe[] = R"(
+    new Promise((resolve) => {
+      const probe = document.createElement('extensionoptions');
+      probe.extension = $1;
+      probe.addEventListener('load', () => resolve(), {once: true});
+      document.body.appendChild(probe);
+    });
+  )";
+  ASSERT_TRUE(
+      content::ExecJs(webui, content::JsReplace(kEmbedProbe, extension->id())));
+  EXPECT_EQ(2u, guest_view_manager()->num_guests_created());
+  EXPECT_EQ(2u, guest_view_manager()->GetCurrentGuestCount());
+
+  // The moved element's guest still exists and is still attached.
+  guest_view::GuestViewBase* guest =
+      guest_view_manager()->GetGuestByInstanceIDSafely(
+          guest_instance_id,
+          webui->GetPrimaryMainFrame()->GetProcess()->GetID());
+  ASSERT_TRUE(guest);
+  EXPECT_TRUE(guest->attached());
 }
 
