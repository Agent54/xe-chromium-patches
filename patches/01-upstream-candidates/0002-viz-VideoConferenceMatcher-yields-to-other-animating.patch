+
+// Two 30 fps videos do not lower the display rate while other content updates
+// on every display frame, or faster than the videos.
+TEST(FrameIntervalMatchersTest, VideoConferenceYieldsToOtherContent) {
+  Settings settings;
+  Inputs inputs = BuildDefaultInputs(settings, /*num_sinks=*/3u);
+  VideoConferenceMatcher matcher;
+  for (uint32_t sink : {1u, 2u}) {
+    FrameIntervalInputs& video = inputs.inputs_map[FrameSinkId(0, sink)];
+    video.content_interval_info.push_back(
+        {ContentFrameIntervalType::kVideo, base::Hertz(30)});
+    video.has_only_content_frame_interval_updates = true;
+  }
+  ExpectResult(matcher.Match(inputs), base::Hertz(30),
+               ResultIntervalType::kExact);
+
+  // An animation that takes every display frame (e.g. a WebGL scene).
+  inputs.has_continuous_non_video_updates = true;
+  ExpectNullResult(matcher.Match(inputs));
+  inputs.has_continuous_non_video_updates = false;
+
+  // Content updating at 60 fps.
+  inputs.fastest_non_video_update_interval = base::Hertz(60);
+  ExpectNullResult(matcher.Match(inputs));
+
+  // Content updating slower than the videos does not keep the rate up.
+  inputs.fastest_non_video_update_interval = base::Hertz(10);
+  ExpectResult(matcher.Match(inputs), base::Hertz(30),
+               ResultIntervalType::kExact);
+
+  // The previous behaviour, behind the feature.
+  base::test::ScopedFeatureList disabled;
+  disabled.InitAndDisableFeature(
+      features::kVideoConferenceMatcherYieldsToAnimation);
+  inputs.has_continuous_non_video_updates = true;
+  ExpectResult(matcher.Match(inputs), base::Hertz(30),
+               ResultIntervalType::kExact);
 }
 
