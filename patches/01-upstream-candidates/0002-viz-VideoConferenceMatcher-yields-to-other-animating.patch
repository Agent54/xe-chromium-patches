+
+void FrameIntervalDecider::UpdateHistory(
+    FrameIntervalMatcher::Inputs& matcher_inputs) {
+  constexpr int kWindow = 8;
+  constexpr int kContinuousMin = 7;
+  for (const auto& [frame_sink_id, inputs] : matcher_inputs.inputs_map) {
+    SinkUpdateHistory& history = update_history_[frame_sink_id];
+    const bool new_frame = !inputs.frame_time.is_null() &&
+                           inputs.frame_time != history.last_frame_time;
+    if (new_frame && !history.last_frame_time.is_null()) {
+      const base::TimeDelta interval =
+          inputs.frame_time - history.last_frame_time;
+      // Frame times are not guaranteed to be monotonic; a non-positive
+      // interval must not enter the smoothed interval.
+      if (interval.is_positive()) {
+        history.smoothed_interval =
+            history.intervals == 0
+                ? interval
+                : (history.smoothed_interval * 3 + interval) / 4;
+        ++history.intervals;
+      }
+    }
+    if (new_frame) {
+      history.last_frame_time = inputs.frame_time;
+    }
+    history.new_frame_bits =
+        ((history.new_frame_bits << 1) | (new_frame ? 1u : 0u)) &
+        ((1u << kWindow) - 1u);
+    history.drawn = std::min(history.drawn + 1, kWindow);
+    history.last_frame_id = matcher_inputs.frame_id;
+
+    // Sinks whose only updates are videos are what the video matchers decide
+    // about; everything else is "other content".
+    const bool video_only =
+        inputs.has_only_content_frame_interval_updates &&
+        !inputs.content_interval_info.empty() &&
+        std::ranges::all_of(inputs.content_interval_info, [](const auto& info) {
+          return info.type == ContentFrameIntervalType::kVideo;
+        });
+    if (video_only || inputs.frame_time.is_null()) {
+      continue;
+    }
+    if (history.drawn == kWindow &&
+        std::popcount(history.new_frame_bits) >= kContinuousMin) {
+      matcher_inputs.has_continuous_non_video_updates = true;
+    }
+    const bool still_updating =
+        history.intervals >= 3 &&
+        matcher_inputs.aggregated_frame_time - inputs.frame_time <=
+            2 * history.smoothed_interval;
+    if (still_updating &&
+        (!matcher_inputs.fastest_non_video_update_interval ||
+         history.smoothed_interval <
+             *matcher_inputs.fastest_non_video_update_interval)) {
+      matcher_inputs.fastest_non_video_update_interval =
+          history.smoothed_interval;
+    }
+  }
+  // Forget sinks not drawn for a while.
+  base::EraseIf(update_history_, [&](const auto& entry) {
+    return matcher_inputs.frame_id - entry.second.last_frame_id > 120u;
+  });
 }
 
