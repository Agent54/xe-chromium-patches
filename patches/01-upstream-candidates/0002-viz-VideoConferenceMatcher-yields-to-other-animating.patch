   Settings settings_;
   std::vector<std::unique_ptr<FrameIntervalMatcher>> matchers_;
 
+  // Fills Inputs::has_continuous_non_video_updates and
+  // fastest_non_video_update_interval from `update_history_`.
+  void UpdateHistory(FrameIntervalMatcher::Inputs& matcher_inputs);
+
   base::TimeTicks current_result_frame_time_;
   std::optional<Result> current_result_;
   uint64_t frame_id_ = 0u;
+
+  struct SinkUpdateHistory {
+    base::TimeTicks last_frame_time;
+    // Bit i: a new frame in the i-th most recent aggregation that drew it.
+    uint32_t new_frame_bits = 0u;
+    int drawn = 0;
+    base::TimeDelta smoothed_interval;
+    int intervals = 0;
+    uint64_t last_frame_id = 0u;
+  };
+  base::flat_map<FrameSinkId, SinkUpdateHistory> update_history_;
 };
 
 }  // namespace viz
diff --git a/components/viz/service/display/frame_interval_decider_unittest.cc b/components/viz/service/display/frame_interval_decider_unittest.cc
--- a/components/viz/service/display/frame_interval_decider_unittest.cc
+++ b/components/viz/service/display/frame_interval_decider_unittest.cc
@@ -477,3 +477,74 @@
 
 }  // namespace
 }  // namespace viz
+
+namespace viz {
+
+// The decider's per-sink history feeds VideoConferenceMatcher: two 30 fps
+// video sinks next to a 60 fps scene keep the default (display) rate; once
+// the scene stops, the videos lower it as before; a window with only the
+// videos lowers it too.
+TEST_F(FrameIntervalDeciderTest, VideoConferenceYieldsToAnimatingScene) {
+  settings_.increase_frame_interval_timeout = base::Milliseconds(50);
+  // Sets up `settings_` (with the result callback); then use only the real
+  // matcher.
+  InitializeDecider();
+  std::vector<std::unique_ptr<FrameIntervalMatcher>> matchers;
+  matchers.push_back(std::make_unique<VideoConferenceMatcher>());
+  decider_->UpdateSettings(settings_, std::move(matchers));
+
+  auto video_inputs = [](base::TimeTicks t) {
+    FrameIntervalInputs inputs;
+    inputs.frame_time = t;
+    inputs.has_only_content_frame_interval_updates = true;
+    inputs.content_interval_info.push_back(
+        {ContentFrameIntervalType::kVideo, base::Hertz(30)});
+    return inputs;
+  };
+  FrameIntervalInputs scene_inputs;
+  scene_inputs.frame_time = kNow;
+  Surface* video1 = CreateSurface(FrameSinkId(0, 1), video_inputs(kNow));
+  Surface* video2 = CreateSurface(FrameSinkId(0, 2), video_inputs(kNow));
+  Surface* scene = CreateSurface(FrameSinkId(0, 3), scene_inputs);
+
+  const base::TimeDelta vsync = base::Hertz(60);
+  base::TimeTicks t = kNow;
+  // Videos update every other display frame; `scene_updates` decides whether
+  // the scene updates on every one.
+  auto run = [&](int frames, bool scene_updates,
+                 std::vector<Surface*> drawn) {
+    for (int i = 0; i < frames; ++i) {
+      t += vsync;
+      if (i % 2 == 0) {
+        UpdateFrame(video1, video_inputs(t));
+        UpdateFrame(video2, video_inputs(t));
+      }
+      if (scene_updates) {
+        scene_inputs.frame_time = t;
+        UpdateFrame(scene, scene_inputs);
+      }
+      DrawSurfaces(drawn, t);
+    }
+  };
+
+  run(60, /*scene_updates=*/true, {video1, video2, scene});
+  ASSERT_TRUE(has_result());
+  ExpectResult(TakeLastResult(), FrameIntervalClass::kDefault);
+
+  // The scene stops: the videos decide the rate.
+  run(60, /*scene_updates=*/false, {video1, video2, scene});
+  ASSERT_TRUE(has_result());
+  ExpectResult(TakeLastResult(), base::Hertz(30));
+
+  // The scene animates again: back to the display rate.
+  run(30, /*scene_updates=*/true, {video1, video2, scene});
+  ASSERT_TRUE(has_result());
+  ExpectResult(TakeLastResult(), FrameIntervalClass::kDefault);
+
+  // Only the videos in the window.
+  run(60, /*scene_updates=*/false, {video1, video2});
+  ASSERT_TRUE(has_result());
+  ExpectResult(TakeLastResult(), base::Hertz(30));
+}
+
+}  // namespace viz
