+bool FrameSinkManagerImpl::AdmitKeyedCopy(base::TimeTicks expected_display_time,
+                                          double cost,
+                                          bool low_priority,
+                                          int waited_frames) {
+  if (!expected_display_time.is_null() &&
+      expected_display_time != keyed_copy_budget_frame_) {
+    keyed_copy_budget_frame_ = expected_display_time;
+    keyed_copy_budget_remaining_ = features::kKeyedCopyBudgetUnits.Get();
+  }
+  if (low_priority && waited_frames < features::kKeyedCopyMaxWaitFrames.Get() &&
+      keyed_copy_budget_remaining_ < cost) {
+    return false;
+  }
+  keyed_copy_budget_remaining_ -= cost;
+  return true;
+}
