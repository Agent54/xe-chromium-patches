 void CompositorFrameSinkSupport::OnSurfaceWillDraw(Surface* surface) {
+  // Experiment (kKeyedCopyBudget): copies deferred for budget are
+  // retried on every drawn frame (also when the sink has no new damage), and
+  // age while they wait.
+  if (!budget_dirty_keys_.empty()) {
+    bool admitted = false;
+    for (auto it = deferred_copy_output_requests_.begin();
+         it != deferred_copy_output_requests_.end();) {
+      const base::UnguessableToken key =
+          *(*it)->copy_output_request->wait_for_new_frame_key();
+      if (!budget_dirty_keys_.contains(key) ||
+          !AdmitKeyedCopy(**it, base::TimeTicks())) {
+        ++it;
+        continue;
+      }
+      last_copied_damage_by_key_[key] = damage_count_;
+      copy_output_requests_.push_back(std::move(*it));
+      it = deferred_copy_output_requests_.erase(it);
+      admitted = true;
+    }
+    if (admitted) {
+      // Taken at the next aggregation; make sure there is one.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&CompositorFrameSinkSupport::ForceRedrawForCopy,
+                         weak_factory_.GetWeakPtr()));
+    }
+  }
   if (last_drawn_frame_index_ >= surface->GetActiveFrameIndex()) {
     return;
   }
   last_drawn_frame_index_ = surface->GetActiveFrameIndex();
+}
+
+bool CompositorFrameSinkSupport::AdmitKeyedCopy(
+    const PendingCopyOutputRequest& request,
+    base::TimeTicks expected_display_time) {
+  const CopyOutputRequest& copy = *request.copy_output_request;
+  const base::UnguessableToken& key = *copy.wait_for_new_frame_key();
+  if (!base::FeatureList::IsEnabled(features::kKeyedCopyBudget)) {
+    return true;
+  }
+  const double cost =
+      copy.has_area() ? static_cast<double>(copy.area().size().Area64()) /
+                            (640.0 * 360.0)
+                      : 1.0;
+  int& waited = budget_waited_[key];
+  if (!frame_sink_manager_->AdmitKeyedCopy(expected_display_time, cost,
+                                           copy.low_priority(), waited)) {
+    ++waited;
+    budget_dirty_keys_.insert(key);
+    return false;
+  }
+  budget_waited_.erase(key);
+  budget_dirty_keys_.erase(key);
+  return true;
+}
+
+void CompositorFrameSinkSupport::ForceRedrawForCopy() {
+  if (last_activated_surface_id_.is_valid()) {
+    BeginFrameAck ack;
+    ack.has_damage = true;
+    surface_manager_->SurfaceModified(
+        last_activated_surface_id_, ack,
+        SurfaceObserver::HandleInteraction::kNoChange);
+  }
 }
 
