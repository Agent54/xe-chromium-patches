From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <luke@agent54.org>
Date: Sun, 22 Nov 2026 23:32:46 +0000
Subject: [PATCH 45/50] Experiment: spread remote frames' compositing-scale steps over frames (kStaggerCompositingScaleSteps)

With kStaggerCompositingScaleSteps (disabled by default) a remote frame
about to take a new compositing scale asks a per-renderer
ScaleStepScheduler (remote_frame_view.cc): at most 4 frames per 16 ms
window step, the largest waiting ones (on-screen area: frame area x the
frame-to-local-root scale squared) first; the others keep their scale and
re-check 16 ms later. Each step makes the child re-raster, so after a zoom
the re-raster of all visible cards is spread over several display frames.
---
diff --git a/third_party/blink/renderer/core/frame/remote_frame_view.cc b/third_party/blink/renderer/core/frame/remote_frame_view.cc
--- a/third_party/blink/renderer/core/frame/remote_frame_view.cc
+++ b/third_party/blink/renderer/core/frame/remote_frame_view.cc
@@ -9,6 +9,7 @@
 #include <cmath>
 
 #include "base/feature_list.h"
+#include "base/no_destructor.h"
 #include "base/metrics/histogram_macros.h"
 #include "base/trace_event/trace_event.h"
 #include "components/paint_preview/common/paint_preview_tracker.h"
@@ -28,6 +29,8 @@
 #include "third_party/blink/renderer/core/page/page.h"
 #include "third_party/blink/renderer/core/paint/paint_info.h"
 #include "third_party/blink/renderer/platform/graphics/graphics_context.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_map.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
 #include "third_party/blink/renderer/platform/heap/persistent.h"
 #include "third_party/blink/renderer/platform/wtf/functional.h"
 #include "third_party/blink/renderer/platform/graphics/paint/cull_rect.h"
@@ -55,6 +58,55 @@
 // Experiment: see RemoteFrameView::UpdateCompositingScaleFactor().
 BASE_FEATURE(kHoldCompositingScaleWhileTransforming,
              base::FEATURE_DISABLED_BY_DEFAULT);
+BASE_FEATURE(kStaggerCompositingScaleSteps, base::FEATURE_DISABLED_BY_DEFAULT);
+
+// Experiment (kStaggerCompositingScaleSteps): spreads compositing
+// scale steps of remote frames over display frames (each step makes the child
+// re-raster): at most kPerWindow frames per kWindow take a new scale, the
+// largest waiting ones (on-screen area) first.
+class ScaleStepScheduler final : public GarbageCollected<ScaleStepScheduler> {
+ public:
+  static ScaleStepScheduler& Get() {
+    static base::NoDestructor<Persistent<ScaleStepScheduler>> instance(
+        MakeGarbageCollected<ScaleStepScheduler>());
+    return **instance;
+  }
+
+  bool MayStep(RemoteFrameView* view, double area) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (now - window_start_ >= kWindow) {
+      window_start_ = now;
+      used_ = 0;
+    }
+    waiting_.Set(view, area);
+    if (used_ >= kPerWindow) {
+      return false;
+    }
+    int larger = 0;
+    for (const auto& entry : waiting_) {
+      if (entry.value > area) {
+        ++larger;
+      }
+    }
+    if (larger >= kPerWindow - used_) {
+      return false;
+    }
+    waiting_.erase(view);
+    ++used_;
+    return true;
+  }
+
+  void Done(RemoteFrameView* view) { waiting_.erase(view); }
+
+  void Trace(Visitor* visitor) const { visitor->Trace(waiting_); }
+
+ private:
+  static constexpr base::TimeDelta kWindow = base::Milliseconds(16);
+  static constexpr int kPerWindow = 4;
+  HeapHashMap<WeakMember<RemoteFrameView>, double> waiting_;
+  base::TimeTicks window_start_;
+  int used_ = 0;
+};
 }  // namespace
 
 
@@ -356,11 +408,16 @@
   // - kHoldCompositingScaleWhileTransforming: no step in either direction
   //   while the scale keeps changing; the new scale is applied once it has
   //   been stable for 150 ms.
+  // - kStaggerCompositingScaleSteps: at most a few frames per 16 ms window
+  //   take a new scale, largest on screen first; the others re-check a frame
+  //   later.
   const bool quantize =
       base::FeatureList::IsEnabled(kQuantizeRemoteFrameCompositingScale);
   const bool hold =
       base::FeatureList::IsEnabled(kHoldCompositingScaleWhileTransforming);
-  if (quantize || hold) {
+  const bool stagger =
+      base::FeatureList::IsEnabled(kStaggerCompositingScaleSteps);
+  if (quantize || hold || stagger) {
     const float raw = compositing_scale_factor_;
     const base::TimeTicks now = base::TimeTicks::Now();
     if (raw != raw_compositing_scale_factor_) {
@@ -392,6 +449,19 @@
           recheck = kDownSettle - stable_for;
         }
       }
+      if (stagger && applied != previous_scale_factor) {
+        // On-screen area of the frame in the local root, for priority.
+        const double area = static_cast<double>(Size().Area64()) *
+                            frame_to_local_root_scale_factor *
+                            frame_to_local_root_scale_factor;
+        if (!MayStepCompositingScale(area)) {
+          applied = previous_scale_factor;
+          recheck = base::Milliseconds(16);
+        }
+      }
+    }
+    if (stagger && applied == target) {
+      DoneSteppingCompositingScale();
     }
     scale_initialized_ = true;
     compositing_scale_factor_ = applied;
@@ -415,6 +485,14 @@
 
   if (compositing_scale_factor_ != previous_scale_factor)
     remote_frame_->SynchronizeVisualProperties();
+}
+
+bool RemoteFrameView::MayStepCompositingScale(double area) {
+  return ScaleStepScheduler::Get().MayStep(this, area);
+}
+
+void RemoteFrameView::DoneSteppingCompositingScale() {
+  ScaleStepScheduler::Get().Done(this);
 }
 
 void RemoteFrameView::Dispose() {
diff --git a/third_party/blink/renderer/core/frame/remote_frame_view.h b/third_party/blink/renderer/core/frame/remote_frame_view.h
--- a/third_party/blink/renderer/core/frame/remote_frame_view.h
+++ b/third_party/blink/renderer/core/frame/remote_frame_view.h
@@ -130,7 +130,9 @@
   base::TimeTicks raw_scale_changed_at_;
   bool scale_recheck_pending_ = false;
   bool scale_initialized_ = false;
-
+  // Experiment (kStaggerCompositingScaleSteps).
+  bool MayStepCompositingScale(double area);
+  void DoneSteppingCompositingScale();
 
   std::optional<NaturalSizingInfo> natural_sizing_info_;
   bool needs_occlusion_tracking_ = false;
