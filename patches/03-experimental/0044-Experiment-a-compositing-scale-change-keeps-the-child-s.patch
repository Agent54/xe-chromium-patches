From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xe Chromium Patches <luke@agent54.org>
Date: Sun, 22 Nov 2026 23:32:46 +0000
Subject: [PATCH 44/50] Experiment: a compositing-scale change keeps the child's surface (kRemoteFrameScaleChangeKeepsSurface)

RemoteFrame::SynchronizeVisualProperties() generated a new child
LocalSurfaceId when compositing_scale_factor changed. The compositing scale
only sets the child's raster scale (WebFrameWidgetImpl ->
LayerTreeHost::SetExternalPageScaleFactor: 'affects surface contents
scale, but not transform geometry'); the child's frame size and DSF, which
viz checks against the surface (Surface::QueueFrame), are unchanged. With
the new surface the embedder's next frame embeds a surface the child has
not produced yet and waits for it (surface synchronization), while the
child re-rasters at the new scale - for every card whose scale changed, in
the same frame.

With kRemoteFrameScaleChangeKeepsSurface (disabled by default) a scale
change no longer counts toward synchronized_props_changed (no new id) but
still sends the visual properties (new scale_changed term); the browser
forwards them because compositing_scale_factor is part of
RenderWidgetHostImpl::StoredVisualPropertiesNeedsUpdate(). The embedder
keeps drawing the current surface (the child's last frame, scaled) and the
child's re-rastered frames arrive in it.
---
diff --git a/third_party/blink/renderer/core/frame/remote_frame.cc b/third_party/blink/renderer/core/frame/remote_frame.cc
--- a/third_party/blink/renderer/core/frame/remote_frame.cc
+++ b/third_party/blink/renderer/core/frame/remote_frame.cc
@@ -85,6 +85,9 @@
 // feature remains as a kill switch.
 BASE_FEATURE(kRemoteFrameSurfaceIgnoresTransformedSize,
              base::FEATURE_ENABLED_BY_DEFAULT);
+// Experiment: see RemoteFrame::SynchronizeVisualProperties().
+BASE_FEATURE(kRemoteFrameScaleChangeKeepsSurface,
+             base::FEATURE_DISABLED_BY_DEFAULT);
 
 
 namespace {
@@ -1063,8 +1066,15 @@
           pending_visual_properties_.css_zoom_factor ||
       sent_visual_properties_->page_scale_factor !=
           pending_visual_properties_.page_scale_factor ||
-      sent_visual_properties_->compositing_scale_factor !=
-          pending_visual_properties_.compositing_scale_factor ||
+      // Experiment (kRemoteFrameScaleChangeKeepsSurface): the
+      // compositing scale only sets the child's raster scale (cc external
+      // page scale factor), not its frame size or DSF; with the feature it is
+      // sent without a new surface (below), so the embedder keeps drawing
+      // the current one, scaled, until the child's re-rastered frames arrive
+      // in it, instead of waiting for a new surface.
+      (!base::FeatureList::IsEnabled(kRemoteFrameScaleChangeKeepsSurface) &&
+       sent_visual_properties_->compositing_scale_factor !=
+           pending_visual_properties_.compositing_scale_factor) ||
       sent_visual_properties_->cursor_accessibility_scale_factor !=
           pending_visual_properties_.cursor_accessibility_scale_factor ||
       sent_visual_properties_->is_pinch_gesture_active !=
@@ -1090,7 +1100,12 @@
   bool rect_changed = !sent_visual_properties_ ||
                       sent_visual_properties_->rect_in_local_root !=
                           pending_visual_properties_.rect_in_local_root;
-  bool visual_properties_changed = synchronized_props_changed || rect_changed;
+  const bool scale_changed =
+      !sent_visual_properties_ ||
+      sent_visual_properties_->compositing_scale_factor !=
+          pending_visual_properties_.compositing_scale_factor;
+  bool visual_properties_changed =
+      synchronized_props_changed || rect_changed || scale_changed;
 
   if (visual_properties_changed && propagate) {
     GetRemoteFrameHostRemote().SynchronizeVisualProperties(
