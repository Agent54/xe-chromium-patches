From: Xe Chromium Patches <noreply@xe.invalid>
Date: Sun, 22 Nov 2026 15:58:09 +0000
Subject: [PATCH 36/50] experiment: spread throttled frame sinks' BeginFrame phases

Feature SpreadThrottledFrameSinkPhases (off by default): a throttled sink
gets BeginFrames on display frames whose index (frame time / vsync
interval) matches a per-sink phase within the throttle ratio, derived from
its FrameSinkId; never closer than half the interval, and on the next
frame if its slot was skipped. Before, all sinks throttled at once ticked
in the same display frame (a burst every interval).
---
diff --git a/components/viz/service/frame_sinks/compositor_frame_sink_support.cc b/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
--- a/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
+++ b/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
@@ -77,6 +77,13 @@
 BASE_FEATURE(kCleanupOrphanedReservedResourceIds,
              base::FEATURE_ENABLED_BY_DEFAULT);
 
+// Experiment: throttled frame sinks get their BeginFrames on a fixed
+// grid of display frames with a per-sink phase (derived from the
+// FrameSinkId), so that many sinks throttled to the same rate do not all
+// produce a frame in the same display frame.
+BASE_FEATURE(kSpreadThrottledFrameSinkPhases,
+             base::FEATURE_DISABLED_BY_DEFAULT);
+
 bool RecordShouldSendBeginFrame(const std::string& reason, bool should_send) {
   TRACE_EVENT2("viz", "SendBeginFrameDecision", "reason", reason, "should_send",
                should_send);
@@ -1691,4 +1698,32 @@
     return false;
+  }
+
+  // An infinite interval (an unthrottled-forever sink) has no ratio to spread.
+  if (base::FeatureList::IsEnabled(kSpreadThrottledFrameSinkPhases) &&
+      !begin_frame_interval().is_inf()) {
+    // Experiment: send on display frames whose index (frame time in
+    // vsync intervals) matches this sink's phase within the throttle ratio.
+    const int64_t ratio = std::max<int64_t>(
+        1, (begin_frame_interval() + vsync_interval / 2).IntDiv(vsync_interval));
+    if (ratio > 1) {
+      const int64_t frame_index =
+          ((frame_time - base::TimeTicks()) + vsync_interval / 2)
+              .IntDiv(vsync_interval);
+      const uint64_t hash =
+          (static_cast<uint64_t>(frame_sink_id_.client_id()) * 2654435761u) ^
+          (static_cast<uint64_t>(frame_sink_id_.sink_id()) * 40503u);
+      const int64_t phase = static_cast<int64_t>(hash % ratio);
+      // Never send two BeginFrames closer than half the interval (e.g. right
+      // after the throttle was set or the phase changed); if the display
+      // skipped this sink's slot (missed vsync), send on the next frame
+      // instead of waiting a whole cycle.
+      const base::TimeDelta since_last = frame_time - last_frame_time_;
+      const bool too_soon = since_last < begin_frame_interval() / 2;
+      const bool overdue =
+          since_last >= begin_frame_interval() + vsync_interval / 2;
+      const int64_t slot = ((frame_index % ratio) + ratio) % ratio;
+      return too_soon || (slot != phase && !overdue);
+    }
   }
 
